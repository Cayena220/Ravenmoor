# Text files are LF in the repository and in every checkout, whatever core.autocrlf says.
# tools/sync_scripts.py compares script text byte for byte, so mixed line endings show up as false changes.
* text=auto eol=lf
*.png binary
# Authored world exceeds normal Git hosting limits; keep its binary in Git LFS.
blender/exports/WorldPlan.blend filter=lfs diff=lfs merge=lfs -text
