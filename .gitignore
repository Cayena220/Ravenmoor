# Roblox Studio's open-file lock (machine name and session id)
*.rbxlx.lock
# Backups written by tools/sync_scripts.py
*.rbxlx.bak
*.rbxlx.bak-*
__pycache__/
# Generated exports stay local except the authored, optimized WorldPlan package.
blender/exports/*
!blender/exports/WorldPlan.blend
!blender/exports/WorldPlan_Academy_Integration.json
!blender/exports/WorldPlan_Optimization/
