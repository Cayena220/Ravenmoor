    {Id = "Howlers", Title = "Under a silver moon", Hint = "Defeat five Moonhowlers. They grow stronger at night.", Kind = "Kill", Target = "Moonhowler", Need = 5, XP = 1500, Gold = 200, Anchor = "HowlerDen"},
    {Id = "Seal", Title = "The Rotbark Seal", Hint = "Defeat the Rotbark Sentinel. Tonitra unlocks at level 15. Reward: the Stormfork wand.", Kind = "Kill", Target = "RotbarkSentinel", Need = 1, XP = 2200, Gold = 300, Anchor = "Rotbark", Wand = "Stormfork"},
