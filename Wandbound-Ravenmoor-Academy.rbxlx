			<Item class="ModuleScript" referent="RBX0000038A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[return {
    Thornimp = {Name = "Thornimp", Level = 5, Rank = "Normal", Color = {94, 136, 74}, Speed = 12, Range = 5, Cooldown = 1.8, Size = 3},
    Gloomspider = {Name = "Gloomspider", Level = 8, Rank = "Normal", Color = {111, 80, 148}, Speed = 14, Range = 6, Cooldown = 2.4, Size = 3, Status = "Chilled"},
    Lanternwisp = {Name = "Lanternwisp", Level = 10, Rank = "Normal", Color = {116, 220, 219}, Speed = 11, Range = 28, Cooldown = 2.5, Size = 2, Flying = true},
    Moonhowler = {Name = "Moonhowler", Level = 12, Rank = "Normal", Color = {105, 115, 144}, Speed = 19, Range = 6, Cooldown = 2.2, Size = 3},
    RotbarkSentinel = {Name = "Rotbark Sentinel", Level = 18, Rank = "Elite", Color = {112, 86, 52}, Speed = 7, Range = 13, Cooldown = 3.8, Size = 6},
    MotherVexweave = {Name = "Mother Vexweave", Level = 20, Rank = "Boss", Color = {143, 57, 108}, Speed = 10, Range = 18, Cooldown = 3.5, Size = 9},
}
]]></ProtectedString>
