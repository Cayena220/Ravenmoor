			<string name="Name">ServerStorage</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">03d2e6901b9fab800aeb6390000003c3</UniqueId>
		</Properties>
		<Item class="ModuleScript" referent="RBX0000039C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Server-only: clients cannot award these rolls.
return {
    Thornimp = {Item = "Thorn Barb", Chance = 0.7},
    Gloomspider = {Item = "Spider Silk", Chance = 0.6, Tome = "Frigora", TomeChance = 0.01},
    Lanternwisp = {Item = "Wisp Essence", Chance = 0.7, Tome = "Somnara", TomeChance = 0.01},
    Moonhowler = {Item = "Moonhowler Fang", Chance = 0.65},
    RotbarkSentinel = {Item = "Heartwood", Chance = 1, Wand = {Rarity = "Uncommon", Chance = 0.25}},
    MotherVexweave = {Item = "Widow's Bite trophy", Chance = 1, Wand = {Rarity = "Rare", Chance = 0.35}, Named = {Id = "WidowsBite", Chance = 0.1}},
}
]]></ProtectedString>
				<string name="ScriptGuid">{5B14A756-A71F-4EEB-8D52-F8C4E87559E4}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
