				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000392">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local F = require(Shared.Formulas)
local Wands = require(Shared.WandData)
local C = {}
local CC = {Silenced=true,Rooted=true,Airborne=true,Asleep=true,Stunned=true}
function C:Init(services) self.S = services; self.States = {}; self.Targets = {} end
function C:Register(model, state)
    state.Model = model; state.Statuses = {}; state.LastCombat = -100; state.Shield = 0
    state.Humanoid = model:FindFirstChildOfClass("Humanoid"); state.Root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
    self.Targets[model] = state
    return state
end
function C:Resolve(part)
    local node = part
    while node and node ~= workspace do if self.Targets[node] then return self.Targets[node] end; node = node.Parent end
end
function C:Has(state, status)
    local value = state.Statuses[status]; return value and value.Until > os.clock()
end
function C:CanAct(state)
    return state and state.Humanoid.Health > 0 and not self:Has(state,"Asleep") and not self:Has(state,"Airborne") and not self:Has(state,"Stunned")
end
function C:Status(target, name, duration, source, dps)
    if not target or target.Humanoid.Health <= 0 or target.Rank == "Boss" and CC[name] then return end
    local now = os.clock()
    if CC[name] then
        if now < (target.ImmuneUntil or 0) then return end
        if now > (target.CCWindow or 0) then target.CCCount = 0; target.CCWindow = now+10 end
        target.CCCount = (target.CCCount or 0)+1
        duration = duration * F.CCMult(target.CCCount)
        if target.CCCount >= 3 then target.ImmuneUntil = now+duration+5 end
        if duration <= 0 then return end
    end
    target.Statuses[name] = {Until = now+duration, Source = source, Dps = dps or 0, Tick = now+1}
    if name == "Airborne" then
        if target.Player then
            target.Root:ApplyImpulse(Vector3.new(0,target.Root.AssemblyMass*35,0))
        else
            -- Keep the original ground height so overlapping lifts cannot strand a unit in the air.
            if not target.GroundY then
                target.GroundY = target.Root.Position.Y
                target.Model:PivotTo(target.Root.CFrame + Vector3.new(0,6,0))
            end
            local lift = {}; target.Lift = lift
            task.delay(duration,function()
                if target.Lift == lift and target.Model.Parent then
                    local pos=target.Root.Position
                    target.Model:PivotTo(CFrame.new(pos.X,target.GroundY,pos.Z))
                    target.Lift = nil; target.GroundY = nil
                end
            end)
        end
    end
    self.S.NetworkService.FX:FireAllClients("Status", target.Root.Position, name, duration)
end
function C:CanDamage(player, target)
    if not target or not target.Model.Parent or target.Humanoid.Health <= 0 then return false end
    if target.Player then
        if player == target.Player then return false end
        return player and self.S.DuelService:CanDamage(player, target.Player) or false
    end
    if player and self.S.DuelService:IsBusy(player) then return false end
    if target.LessonOwner and target.LessonOwner ~= player then return false end
    return true
end
function C:Damage(player, target, amount, spell, dot)
    if player and not self:CanDamage(player, target) then return false end
    if not target or target.Humanoid.Health <= 0 or os.clock() < (target.InvulnerableUntil or 0) then return false end
    if target.Dummy then
        if player then
            if target.LessonOwner then self.S.ClassService:TargetHit(player, target)
            else self.S.ProgressionService:Event(player, "Practice") end
            self.S.NetworkService.FX:FireAllClients("Damage", target.Root.Position, math.floor(amount), false)
        end
        return true
    end
    if target.Player then
        if player then amount = amount*0.7 end
        if self:Has(target, "Durassa") then amount = amount*0.7 end
        local guarded = self.S.PlayerDataService:Get(target.Player)
        if guarded then amount = amount*(1-F.Stats(guarded).Guard) end
    end
    local crit = false
    if player and spell and not dot then
        local data = self.S.PlayerDataService:Get(player); if not data then return false end
        crit = math.random() < F.Stats(data).Crit
        -- Widow's Bite: crits on a held target bite harder. Checked before damage clears Asleep below.
        local bite = Wands.Signature(data) == "VenomBite" and (self:Has(target, "Rooted") or self:Has(target, "Asleep"))
        if crit then amount = amount*(bite and 2 or 1.5) end
    end
    local blocked = math.min(target.Shield or 0, amount)
    target.Shield = math.max(0, (target.Shield or 0)-blocked); amount = math.max(0, amount-blocked)
    target.LastCombat = os.clock()
    if player and self.States[player] then self.States[player].LastCombat = os.clock() end
    if amount > 0 then target.Statuses.Asleep = nil end
    if player and target.MonsterId then
        target.Contributors[player] = (target.Contributors[player] or 0)+amount
        target.Threat[player] = (target.Threat[player] or 0)+amount
    end
    if target.Player and self.S.DuelService:IsBusy(target.Player) and target.Humanoid.Health-amount <= 1 then
        target.Humanoid.Health = 1; self.S.DuelService:Defeated(target.Player)
    elseif target.MonsterId and target.Humanoid.Health-amount <= 0 then
        target.Humanoid.Health = 0; self.S.MonsterService:Killed(target)
    else target.Humanoid.Health = math.max(0, target.Humanoid.Health-amount) end
    if player and spell and not dot then self.S.ProgressionService:Hit(player, spell.Id) end
    self.S.NetworkService.FX:FireAllClients("Damage", target.Root.Position+Vector3.new(0,3,0), math.floor(amount+0.5), crit)
    return true
end
-- Returns the health actually restored.
function C:Heal(player, target, amount)
    if not target or not target.Player or target.Humanoid.Health <= 0 then return 0 end
    if target.Player ~= player and (self.S.DuelService:IsBusy(player) or self.S.DuelService:IsBusy(target.Player)) then return 0 end
    if self.S.DuelService:IsBusy(player) then amount = amount*0.8 end
    local gain = math.min(amount, target.Humanoid.MaxHealth-target.Humanoid.Health)
    target.Humanoid.Health = target.Humanoid.Health+gain
    self.S.NetworkService.FX:FireAllClients("Heal", target.Root.Position, math.floor(gain))
    return gain
end
function C:UpdateStats(player, refill)
    local s = self.States[player]; local d = self.S.PlayerDataService:Get(player)
    if not s or not d then return end
    local stats = F.Stats(d); s.BaseSpeed = stats.Speed; s.MaxMana = stats.Mana; s.Regen = stats.ManaRegen
    s.Humanoid.MaxHealth = stats.HP
    if refill then s.Humanoid.Health = stats.HP; s.Mana = stats.Mana end
    s.Mana = math.min(s.Mana, stats.Mana)
end
function C:HouseTrim(player)
    local d=self.S.PlayerDataService:Get(player); local s=self.States[player]
    if not d or not s or d.House=="" then return end
    local torso=s.Model:FindFirstChild("UpperTorso") or s.Model:FindFirstChild("Torso")
    if not torso then return end
    local trim=s.Model:FindFirstChild("HouseSash")
    if not trim then
        trim=Instance.new("Part"); trim.Name="HouseSash"; trim.Size=Vector3.new(0.5,torso.Size.Y,0.12)
        trim.CanCollide=false; trim.CanQuery=false; trim.CanTouch=false; trim.Massless=true
        trim.CFrame=torso.CFrame*CFrame.new(0.3,0,-torso.Size.Z/2-0.09); trim.Parent=s.Model
        local weld=Instance.new("WeldConstraint"); weld.Part0=torso; weld.Part1=trim; weld.Parent=trim
    end
    trim.Color=Color3.fromRGB(table.unpack(Config.Houses[d.House].Color))
end
function C:BindPlayer(player)
    local function characterAdded(model)
        local hum = model:WaitForChild("Humanoid"); local root = model:WaitForChild("HumanoidRootPart")
        if not self.S.PlayerDataService:Get(player) then return end
        local old = self.States[player]; if old then self.Targets[old.Model] = nil end
        local s = self:Register(model, {Player=player, Mana=100, MaxMana=100, Stamina=100, Cooldowns={},
            BaseSpeed=16, Regen=4, DodgeAt=-100, InvulnerableUntil=os.clock()+5, BusyUntil=0})
        s.Root=root; s.Humanoid=hum; self.States[player]=s; self:UpdateStats(player,true); self.S.WandService:Attach(player); self:HouseTrim(player)
        local d=self.S.PlayerDataService:Get(player); local pos=Config.Waystones[d.LastWaystone] or Config.Waystones.Hollowmere
        self.S.WorldService:Teleport(player,Vector3.new(pos[1],pos[2],pos[3]))
        hum.Died:Connect(function()
            self.S.DuelService:Defeated(player); self.S.ClassService:Cancel(player)
            self.S.NetworkService.UI:FireClient(player,"Knockout",Config.RespawnTime)
            task.delay(Config.RespawnTime,function() if player.Parent and self.S.PlayerDataService:Get(player) then player:LoadCharacterAsync() end end)
        end)
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded,player.Character) end
end
function C:Dodge(player, direction)
    local s=self.States[player]
    if not self:CanAct(s) or self:Has(s,"Rooted") or s.Stamina<35 or os.clock()-s.DodgeAt<0.8 then return end
    if typeof(direction)~="Vector3" or not F.Finite(direction.X) or not F.Finite(direction.Y) or not F.Finite(direction.Z) then return end
    local flat=Vector3.new(direction.X,0,direction.Z); if flat.Magnitude<0.1 then flat=s.Root.CFrame.LookVector*Vector3.new(1,0,1) end
    if flat.Magnitude<0.1 then return end
    flat=flat.Unit
    -- Monsters do not collide, so they must not cut a dodge short.
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={s.Model,self.S.WorldService.Monsters}
    local hit=workspace:Blockcast(s.Root.CFrame,Vector3.new(2,3,2),flat*10,params)
    local distance=hit and math.max(0,hit.Distance-1) or 10
    s.Stamina=s.Stamina-35; s.DodgeAt=os.clock(); s.InvulnerableUntil=os.clock()+(self.S.DuelService:IsBusy(player) and 0.2 or 0.25)
    self.S.WorldService:Teleport(player,s.Root.Position+flat*distance)
    self.S.NetworkService.FX:FireAllClients("Dodge",s.Root.Position)
end
function C:Tick(dt)
    local now=os.clock()
    for model,s in pairs(self.Targets) do
        if not model.Parent then self.Targets[model]=nil
        elseif s.Humanoid.Health>0 then
            for name,st in pairs(s.Statuses) do
                if st.Until<=now then s.Statuses[name]=nil
                elseif name=="Burn" and now>=st.Tick then
                    st.Tick=now+1
                    if not st.Source or self.S.PlayerDataService:Get(st.Source) then self:Damage(st.Source,s,st.Dps,nil,true) end
                end
            end
            if s.Player then
                local factor=1
                if self:Has(s,"Chilled") then factor=factor*0.7 end
                if self:Has(s,"Durassa") then factor=factor*0.8 end
                if self:Has(s,"Velocis") then factor=factor*1.35 end
                if self:Has(s,"Rooted") or not self:CanAct(s) or self.S.DuelService:IsCounting(s.Player) then factor=0 end
                s.Humanoid.WalkSpeed=s.BaseSpeed*factor
                s.Humanoid.JumpPower=factor==0 and 0 or 50
                s.Humanoid.JumpHeight=factor==0 and 0 or 7.2
                s.Mana=math.min(s.MaxMana,s.Mana+dt*s.Regen*(now-s.LastCombat>5 and 2 or 1))
                if s.Light then
                    s.Mana=math.max(0,s.Mana-dt)
                    if s.Mana<1 then s.Light=false; local light=s.Root:FindFirstChild("Glimmora"); if light then light:Destroy() end end
                end
                if now-s.DodgeAt>1 then s.Stamina=math.min(100,s.Stamina+20*dt) end
                if (s.ShieldUntil or 0)<now then s.Shield=0 end
                s.Model:SetAttribute("Shield",s.Shield)
            end
        end
    end
end
function C:Start()
    self.S.NetworkService.Handlers.Dodge=function(player,direction) self:Dodge(player,direction) end
    Players.PlayerRemoving:Connect(function(player)
        local s=self.States[player]; if s then self.Targets[s.Model]=nil end; self.States[player]=nil
    end)
    task.spawn(function()
        local last=os.clock()
        while true do task.wait(0.1); local now=os.clock(); self:Tick(math.min(0.5,now-last)); last=now end
    end)
    task.spawn(function()
        while true do
            task.wait(0.25)
            for player,s in pairs(self.States) do
                if player.Parent then
                    local statuses={}; for name,st in pairs(s.Statuses) do if st.Until>os.clock() then statuses[#statuses+1]=name end end
                    local cooldowns={}; for id,t in pairs(s.Cooldowns) do if t>os.clock() then cooldowns[id]=t-os.clock() end end
                    self.S.NetworkService.State:FireClient(player,{HP=s.Humanoid.Health,MaxHP=s.Humanoid.MaxHealth,Mana=s.Mana,MaxMana=s.MaxMana,
                        Stamina=s.Stamina,Shield=s.Shield,Statuses=statuses,Cooldowns=cooldowns,
                        Class=self.S.ClassService:Schedule(),HouseTotals=self.S.ProgressionService.HouseTotals})
                end
            end
        end
    end)
end
return C
]]></ProtectedString>
					<string name="ScriptGuid">{F829F272-0A41-4EBC-AED4-BD66D9B027CD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CombatService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000765</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000393">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local F=require(game:GetService("ReplicatedStorage").Shared.Formulas)
local D={}
function D:Init(services) self.S=services; self.Invites={}; self.Matches={}; self.Rewards={} end
function D:IsBusy(player) return self.Matches[player]~=nil end
function D:IsCounting(player) local m=self.Matches[player]; return m and os.clock()<m.Starts end
function D:CanDamage(a,b)
    local m=self.Matches[a]
    return m~=nil and self.Matches[b]==m and a~=b and not m.Ended and os.clock()>=m.Starts
end
function D:Invite(player,userId)
    if not F.Finite(userId) or userId%1~=0 or self:IsBusy(player) then return end
    local other=Players:GetPlayerByUserId(userId); local a=self.S.CombatService.States[player]; local b=other and self.S.CombatService.States[other]
    if not a or not b or a.Humanoid.Health<=0 or b.Humanoid.Health<=0 or other==player or self:IsBusy(other) then return end
    if not self.S.WorldService:Near(player,"Duelmaster",35) or not self.S.WorldService:Near(other,"Duelmaster",35) then return self.S.NetworkService:Notice(player,"Both duelists must stand near Duelmaster Vey.") end
    local invite=self.Invites[other]
    if invite and os.clock()<invite.Expires then return self.S.NetworkService:Notice(player,"That student already has an invitation.") end
    self.Invites[other]={From=player,Expires=os.clock()+20}
    self.S.NetworkService.UI:FireClient(other,"DuelInvite",{Name=player.DisplayName,UserId=player.UserId})
    self.S.NetworkService:Notice(player,"Duel invitation sent.")
end
function D:Respond(player,accept)
    local invite=self.Invites[player]; self.Invites[player]=nil
    if type(accept)~="boolean" or not invite or invite.Expires<os.clock() or not accept then return end
    if self.Active and not self.Active.Ended then return self.S.NetworkService:Notice(player,"The dueling platform is occupied. Try again after this match.") end
    local other=invite.From
    if not other.Parent or self:IsBusy(player) or self:IsBusy(other) then return end
    if not self.S.WorldService:Near(player,"Duelmaster",35) or not self.S.WorldService:Near(other,"Duelmaster",35) then return end
    local a=self.S.CombatService.States[player]; local b=self.S.CombatService.States[other]
    if not a or not b or a.Humanoid.Health<=0 or b.Humanoid.Health<=0 then return end
    local m={Players={player,other},Starts=os.clock()+3,Ends=os.clock()+183,Positions={[player]=a.Root.Position,[other]=b.Root.Position}}
    self.Active=m
    self.Matches[player]=m; self.Matches[other]=m
    for i,p in ipairs(m.Players) do
        self.S.ClassService:Cancel(p)
        local s=self.S.CombatService.States[p]; s.Humanoid.Health=s.Humanoid.MaxHealth; s.Mana=s.MaxMana; s.Stamina=100; s.Statuses={}; s.Shield=0; s.Cooldowns={}; s.InvulnerableUntil=m.Starts
        self.S.WorldService:Teleport(p,Vector3.new(240,5,i==1 and -120 or -170))
        self.S.NetworkService.UI:FireClient(p,"DuelStart",3)
    end
end
function D:Finish(m,winner)
    if m.Ended then return end; m.Ended=true
    if self.Active==m then self.Active=nil end
    for _,p in ipairs(m.Players) do
        self.Matches[p]=nil
        local s=self.S.CombatService.States[p]
        if s and p.Parent then
            s.Statuses={}; s.Shield=0; s.Cooldowns={}; s.Humanoid.Health=s.Humanoid.MaxHealth; s.Mana=s.MaxMana; s.InvulnerableUntil=os.clock()+5
            self.S.WorldService:Teleport(p,m.Positions[p])
            self.S.NetworkService:Notice(p,winner and (winner==p and "Duel won!" or "Duel lost. Train, adapt, return.") or "Duel ended in a draw.")
        end
    end
    if winner then
        local d=self.S.PlayerDataService:Get(winner)
        if d then
            d.DuelWins=d.DuelWins+1
            local rewards=self.Rewards[winner] or {Hour=math.floor(os.time()/3600),Count=0}; self.Rewards[winner]=rewards
            if rewards.Hour~=math.floor(os.time()/3600) then rewards.Hour=math.floor(os.time()/3600); rewards.Count=0 end
            if rewards.Count<10 then
                rewards.Count=rewards.Count+1; self.S.ProgressionService:HousePoints(winner,5)
                local perk=d.House=="Nightfang" and 1.05 or 1
                self.S.ProgressionService:Award(winner,math.floor(80*perk),math.floor(20*perk))
            end
            self.S.ProgressionService:Refresh(winner)
        end
    end
end
function D:Defeated(player)
    local m=self.Matches[player]; if not m then return end
    local winner=m.Players[1]==player and m.Players[2] or m.Players[1]
    self:Finish(m,winner)
end
function D:Start()
    self.S.NetworkService.Handlers.DuelInvite=function(player,id) self:Invite(player,id) end
    self.S.NetworkService.Handlers.DuelRespond=function(player,accept) self:Respond(player,accept) end
    Players.PlayerRemoving:Connect(function(player) self:Defeated(player); self.Invites[player]=nil; self.Rewards[player]=nil end)
    task.spawn(function()
        while true do
            task.wait(1)
            for player,m in pairs(self.Matches) do
                local root=self.S.WorldService:Root(player)
                if os.clock()>m.Ends then self:Finish(m,nil)
                elseif root and (math.abs(root.Position.X-240)>39 or math.abs(root.Position.Z+145)>45) then self:Defeated(player) end
            end
            for player,inv in pairs(self.Invites) do if not player.Parent or not inv.From.Parent or os.clock()>inv.Expires then self.Invites[player]=nil end end
        end
    end)
end
return D
]]></ProtectedString>
					<string name="ScriptGuid">{2CB0F5E0-3D57-4E5C-8AD3-38546ED9D42E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DuelService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000766</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000394">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.Config)
local F=require(RS.Shared.Formulas)
local Wands=require(RS.Shared.WandData)
local Quests=require(RS.Shared.QuestData)
local I={}
function I:Init(services) self.S=services; self.PotionCooldowns={}; self.Interactions={} end
local advice={
    Oakhart="Open your bag with B to equip a wand. Use K to assign learned spells to 1–4. Right mouse raises your ward; left mouse casts Scintara.",
    Tobb="Watch for red attack circles in Whisperwood. Shift dodges. Bring Thorn Barbs and Spider Silk to the apothecary to brew Health Draughts.",
    Bank="Your vault keeps Gilders separate from your spending money. Deposits and withdrawals are available here.",
    Apothecary="A Thorn Barb and Spider Silk make one Health Draught. Use it from your bag to recover health over four seconds.",
    Duelmaster="Bring another student here for a friendly duel. Both players must accept. You keep your items, and matches end before a lethal hit.",
}
function I:Interact(player,name,choice)
    if type(name)~="string" or type(choice)~="string" then return end
    local npc=self.Interactions[name]; local d=self.S.PlayerDataService:Get(player)
    if not npc or not d or not self.S.WorldService:Near(player,name,15) or self.S.DuelService:IsBusy(player) then return end
    if choice=="Service" then return npc.Callback(player) end
    local message
    if choice=="Advice" then message=advice[name] or "Receive your wand, choose a house, then ask a professor for a lesson. Trace the rune and hit five targets with Scintara."
    elseif choice=="Quest" then local q=Quests[d.Quest]; message=q and (q.Title..": "..q.Hint) or "You have completed the first story. Explore the woods, practise spells, and try a friendly duel."
    elseif choice=="Hello" then message="Welcome, student. What can I help you with?"
    else return end
    self.S.NetworkService.UI:FireClient(player,"Dialogue",{Anchor=name,Name=npc.Name,Text=message,
        Choices={{Id="Service",Label=npc.Action},{Id="Advice",Label="Do you have any advice?"},{Id="Quest",Label="What should I do next?"}}})
end
function I:Prompt(name,label,action,callback)
    local conversational=name~="Mirror" and not name:match("^Waystone_")
    if conversational then self.Interactions[name]={Name=label,Action=action,Callback=callback} end
    local anchor=self.S.WorldService:Anchor(name); if not anchor then warn("Missing interaction",name); return end
    local prompt=Instance.new("ProximityPrompt"); prompt.Name="Interact"; prompt.ObjectText=label; prompt.ActionText=conversational and "Talk" or action
    prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.GamepadKeyCode=Enum.KeyCode.ButtonX
    prompt.MaxActivationDistance=12; prompt.HoldDuration=0.2; prompt.RequiresLineOfSight=false; prompt.Parent=anchor
    prompt.Triggered:Connect(function(player)
        if self.S.WorldService:Near(player,anchor,15) and self.S.PlayerDataService:Get(player)
            and not self.S.DuelService:IsBusy(player) and self.S.NetworkService:Allow(player,"Prompt",3,5) then
                if conversational then self:Interact(player,name,"Hello") else callback(player) end
            end
    end)
end
function I:Unseal(player,part)
    local chest=part
    while chest and chest.Parent~=workspace.Map do
        if chest:GetAttribute("ChestId") then break end
        chest=chest.Parent
    end
    if not chest or not chest:GetAttribute("ChestId") then return end
    local id=chest:GetAttribute("ChestId"); local root=self.S.WorldService:Root(player); local pos=chest:GetPivot().Position
    if not root or (root.Position-pos).Magnitude>35 then return end
    local d=self.S.PlayerDataService:Get(player); if not d then return end
    d.Chests=d.Chests or {}
    if os.time()-(d.Chests[id] or 0)<300 then return self.S.NetworkService:Notice(player,"This chest will refill in five minutes.") end
    d.Chests[id]=os.time(); self.S.ProgressionService:Award(player,25,35)
    self.S.NetworkService:Notice(player,"Unsealed chest · +35 Gilders")
    self.S.NetworkService.FX:FireAllClients("Blast",pos,"Aegara",4)
end
function I:Start()
    self.S.NetworkService.Handlers.Interact=function(player,name,choice) self:Interact(player,name,choice) end
    self:Prompt("Oakhart","Odric Oakhart","Wands",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.HasWand then self.S.WandService:Deliver(player); return self.S.NetworkService.UI:FireClient(player,"Wandery") end
        local wand=Wands.Roll("Common")
        d.HasWand=true; self.S.WandService:Grant(player,wand)
        for _,id in ipairs({"Scintara","Aegara","Glimmora"}) do self.S.ProgressionService:Learn(player,id,true) end
        self.S.ProgressionService:Event(player,"Wand")
        self.S.NetworkService:Notice(player,"The wand chooses you: "..Wands.Name(wand)..". Scintara, Aegara and Glimmora are yours.")
    end)
    self:Prompt("Mirror","Mirror of Choosing","Discover your house",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d.HasWand then return self.S.NetworkService:Notice(player,"Visit Oakhart's Wandery first.") end
        if d.House~="" then return self.S.NetworkService:Notice(player,"You belong to "..d.House..". "..Config.Houses[d.House].Perk) end
        self.S.NetworkService.UI:FireClient(player,"Sorting")
    end)
    for school,teacher in pairs(Config.Teachers) do
        self:Prompt(teacher.Anchor,teacher.Name,"Practice "..teacher.Title,function(player) self.S.ClassService:Begin(player,school) end)
    end
    self:Prompt("Tobb","Tobb Brambleworth","Ask about Whisperwood",function(player)
        self.S.ProgressionService:Event(player,"Tobb")
        self.S.NetworkService:Notice(player,"Thornimps are swarming the woodland path. Watch the red attack circles, and dodge!")
    end)
    self:Prompt("Bank","Vaultkeep Bank","Open vault",function(player) self.S.NetworkService.UI:FireClient(player,"Bank") end)
    self:Prompt("Apothecary","Hollowmere Apothecary","Shop & brew",function(player) self.S.NetworkService.UI:FireClient(player,"Shop") end)
    self:Prompt("Library","Restricted Shelf","Study the archive",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.Level>=14 then self.S.ProgressionService:Learn(player,"Tractum",false)
        else self.S.NetworkService:Notice(player,"Return at level 14 to study Tractum.") end
        self.S.NetworkService.UI:FireClient(player,"Library")
    end)
    self:Prompt("Duelmaster","Duelmaster Kestrel Vey","Open Dueling Club",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.Level>=6 then self.S.ProgressionService:Learn(player,"Excido",false) end
        self.S.NetworkService.UI:FireClient(player,"Duels")
    end)
    for id in pairs(Config.Waystones) do
        self:Prompt("Waystone_"..id,id.." Waystone","Attune / travel",function(player)
            local d=self.S.PlayerDataService:Get(player); d.Waystones[id]=true; d.LastWaystone=id
            self.S.ProgressionService:Refresh(player); self.S.NetworkService.UI:FireClient(player,"Map")
        end)
    end
    self.S.NetworkService.Handlers.Sort=function(player,answers,choice)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not d.HasWand or d.House~="" or type(answers)~="table" or #answers~=5 or type(choice)~="string" or not Config.Houses[choice] then return end
        if not self.S.WorldService:Near(player,"Mirror",18) then return end
        for _,v in ipairs(answers) do if not F.Finite(v) or v%1~=0 or v<1 or v>4 then return end end
        d.House=choice; self.S.ProgressionService:Event(player,"Sorted"); self.S.CombatService:UpdateStats(player,true)
        self.S.NetworkService:Notice(player,"Welcome to "..choice.."!")
    end
    self.S.NetworkService.Handlers.Bank=function(player,action,amount)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Bank",15) or self.S.DuelService:IsBusy(player)
            or not F.Finite(amount) or amount%1~=0 or amount<1 or amount>1000000 then return end
        if action=="Deposit" and d.Gilders>=amount then d.Gilders=d.Gilders-amount; d.BankGilders=d.BankGilders+amount
        elseif action=="Withdraw" and d.BankGilders>=amount then d.BankGilders=d.BankGilders-amount; d.Gilders=d.Gilders+amount
        else return self.S.NetworkService:Notice(player,"Not enough Gilders.") end
        self.S.ProgressionService:Refresh(player); self.S.NetworkService:Notice(player,"Vault balance: "..d.BankGilders.." Gilders")
    end
    self.S.NetworkService.Handlers.Shop=function(player,action)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Apothecary",15) or self.S.DuelService:IsBusy(player) then return end
        if action=="BuyHealth" then
            if d.Gilders<50 then return self.S.NetworkService:Notice(player,"A Health Draught costs 50 Gilders.") end
            d.Gilders=d.Gilders-50; d.Inventory["Health Draught"]=(d.Inventory["Health Draught"] or 0)+1
        elseif action=="BrewHealth" then
            if (d.Inventory["Thorn Barb"] or 0)<1 or (d.Inventory["Spider Silk"] or 0)<1 then return self.S.NetworkService:Notice(player,"You need one Thorn Barb and one Spider Silk.") end
            d.Inventory["Thorn Barb"]=d.Inventory["Thorn Barb"]-1; d.Inventory["Spider Silk"]=d.Inventory["Spider Silk"]-1
            d.Inventory["Health Draught"]=(d.Inventory["Health Draught"] or 0)+1
        else return end
        self.S.ProgressionService:Refresh(player); self.S.NetworkService:Notice(player,"Health Draught added to your bag.")
    end
    self.S.NetworkService.Handlers.UseItem=function(player,id)
        local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
        if type(id)~="string" or not d or not self.S.CombatService:CanAct(s) or self.S.DuelService:IsBusy(player) or (d.Inventory[id] or 0)<1 then return end
        if id=="Health Draught" then
            if os.clock()<(self.PotionCooldowns[player] or 0) then return self.S.NetworkService:Notice(player,"Potions share a 30-second cooldown.") end
            if s.Humanoid.Health>=s.Humanoid.MaxHealth then return self.S.NetworkService:Notice(player,"Your health is already full.") end
            self.PotionCooldowns[player]=os.clock()+30; d.Inventory[id]=d.Inventory[id]-1
            task.spawn(function()
                for _=1,4 do task.wait(1); if self.S.CombatService.States[player]~=s or s.Humanoid.Health<=0 or self.S.DuelService:IsBusy(player) then return end; self.S.CombatService:Heal(player,s,s.Humanoid.MaxHealth*0.1) end
            end)
        elseif id=="Frigora Tome" or id=="Somnara Tome" then
            if self.S.ProgressionService:Learn(player,id:gsub(" Tome$",""),false) then d.Inventory[id]=d.Inventory[id]-1
            else return self.S.NetworkService:Notice(player,"You must meet the spell's level requirement and not already know it.") end
        else return end
        self.S.ProgressionService:Refresh(player)
    end
    self.S.NetworkService.Handlers.Respec=function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Library",15) or self.S.DuelService:IsBusy(player) then return end
        local day=math.floor(os.time()/86400)
        if d.LastRespec==day then return self.S.NetworkService:Notice(player,"Your next free respec is available tomorrow (UTC).") end
        d.LastRespec=day; d.Attributes={Power=0,Focus=0,Vitality=0,Agility=0,Unspent=(d.Level-1)*2}
        self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
    end
    self.S.NetworkService.Handlers.TalentReset=function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Library",15) or self.S.DuelService:IsBusy(player) then return end
        local day=math.floor(os.time()/86400)
        if d.LastTalentReset==day then return self.S.NetworkService:Notice(player,"Your next free skill reset is available tomorrow (UTC).") end
        d.LastTalentReset=day; d.Talents={}
        self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
        self.S.NetworkService:Notice(player,"All skill points refunded.")
    end
    for i=1,3 do
        local model=Instance.new("Model"); model.Name="Training Dummy"
        local root=Instance.new("Part"); root.Name="HumanoidRootPart"; root.Size=Vector3.new(3,5,2); root.Position=Vector3.new(156+(i-1)*9,3,-10)
        root.Anchored=true; root.Material=Enum.Material.Wood; root.Color=Color3.fromRGB(155,118,75); root.Parent=model; model.PrimaryPart=root
        local hum=Instance.new("Humanoid"); hum.RequiresNeck=false; hum.MaxHealth=100000; hum.Health=100000; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
        model.Parent=self.S.WorldService.Targets; self.S.CombatService:Register(model,{Dummy=true})
    end
    for i=1,3 do
        local chest=workspace.Map:FindFirstChild("RuneChest"..i,true); if chest then chest:SetAttribute("ChestId","Chest"..i) end
    end
    Players.PlayerRemoving:Connect(function(player) self.PotionCooldowns[player]=nil end)
end
return I
]]></ProtectedString>
					<string name="ScriptGuid">{8229A4DB-8A22-487D-98DC-140569A8949A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">InteractionService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000767</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000395">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local RS=game:GetService("ReplicatedStorage")
local Data=require(RS.Shared.MonsterData)
local F=require(RS.Shared.Formulas)
local Config=require(RS.Shared.Config)
local Loot=require(game:GetService("ServerStorage").LootTables)
local M={}
local function part(parent,name,size,cf,color,shape)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape then p.Shape=shape end
    p.Parent=parent; return p
end
function M:Init(services) self.S=services; self.Spawns={}; self.Alive={}; self.NextId=0 end
function M:Count() local count=0; for _ in pairs(self.Alive) do count=count+1 end; return count end
function M:Spawn(id,pos,spawner,brood)
    if self:Count()>=Config.MaxMonsters then return end
    local def=Data[id]; local stat=F.Monster(def.Level,def.Rank); local size=brood and 1.7 or def.Size
    local model=Instance.new("Model"); model.Name=def.Name; local color=Color3.fromRGB(table.unpack(def.Color))
    local y=def.Flying and 6 or size/2+0.5; local position=Vector3.new(pos.X,y,pos.Z)
    local root=part(model,"HumanoidRootPart",Vector3.new(size,size,size),CFrame.new(position),color,Enum.PartType.Ball)
    model.PrimaryPart=root
    for side=-1,1,2 do
        part(model,"Eye",Vector3.new(size*0.15,size*0.17,size*0.1),CFrame.new(position+Vector3.new(side*size*0.2,size*0.1,-size*0.46)),Color3.fromRGB(249,206,113)).Material=Enum.Material.Neon
    end
    if id=="Gloomspider" or id=="MotherVexweave" then
        for side=-1,1,2 do for leg=1,4 do
            part(model,"Leg",Vector3.new(size*0.9,0.3,size*0.12),CFrame.new(position+Vector3.new(side*size*0.65,-size*0.2,(leg-2.5)*size*0.24))*CFrame.Angles(0,side*(leg-2.5)*0.3,side*0.2),color)
        end end
    elseif id=="RotbarkSentinel" then
        for side=-1,1,2 do part(model,"Branch",Vector3.new(1,size*1.2,1),CFrame.new(position+Vector3.new(side*size*0.7,1,0))*CFrame.Angles(0,0,side*0.5),color) end
    elseif id=="Lanternwisp" then root.Material=Enum.Material.Neon end
    local hum=Instance.new("Humanoid"); hum.RequiresNeck=false; hum.BreakJointsOnDeath=false; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    hum.MaxHealth=brood and 55 or stat.HP; hum.Health=hum.MaxHealth; hum.Parent=model
    model.Parent=self.S.WorldService.Monsters
    local state=self.S.CombatService:Register(model,{MonsterId=id,Rank=def.Rank,Def=def,Stats=stat,Home=position,Size=size,
        Spawner=spawner,Threat={},Contributors={},NextAttack=0,Phase=1,Brood=brood,State="Idle",Born=os.clock()})
    model:SetAttribute("MonsterId",id); model:SetAttribute("Level",def.Level); model:SetAttribute("Rank",def.Rank)
    self.Alive[state]=true; return state
end
function M:Target(s)
    local best,bestScore=nil,-math.huge
    for _,player in ipairs(Players:GetPlayers()) do
        local target=self.S.CombatService.States[player]
        if target and target.Humanoid.Health>0 and not self.S.WorldService:Zone(target.Root.Position).Safe and not self.S.DuelService:IsBusy(player) then
            local distance=(target.Root.Position-s.Root.Position).Magnitude
            local homeDistance=(target.Root.Position-s.Home).Magnitude
            if distance<((s.Threat[player] or 0)>0 and 80 or 30) and homeDistance<90 then
                local score=(s.Threat[player] or 0)+30-distance
                if score>bestScore then best=target; bestScore=score end
            end
        end
    end
    return best
end
function M:Move(s,destination,dt,speed)
    local C=self.S.CombatService
    if C:Has(s,"Rooted") or not C:CanAct(s) then return end
    local delta=(destination-s.Root.Position)*Vector3.new(1,0,1)
    if delta.Magnitude<1 then return end
    local amount=math.min(delta.Magnitude,speed*dt*(C:Has(s,"Chilled") and 0.7 or 1))
    local dir=delta.Unit
    local params=self.S.SpellService:Params(self.S.SpellService:WorldIgnore())
    local radius=math.min(1.5,s.Size/2)
    local hit=workspace:Spherecast(s.Root.Position,radius,dir*(amount+1),params)
    if hit then
        dir=Vector3.new(-dir.Z,0,dir.X)
        if workspace:Spherecast(s.Root.Position,math.min(1.2,radius),dir*(amount+1),params) then return end
    end
    local p=s.Root.Position+dir*amount
    if s.Def.Flying then p=Vector3.new(p.X,6+math.sin(os.clock()*2)*0.6,p.Z) end
    s.Model:PivotTo(CFrame.lookAt(p,p+dir))
end
function M:Protected(player,position)
    for _,d in ipairs(self.S.SpellService.Domes) do if d.Player==player and d.Until>os.clock() and (d.Pos-position).Magnitude<10 then return true end end
    return false
end
function M:Attack(s,target)
    local C=self.S.CombatService
    local now=os.clock(); if now<s.NextAttack or not C:CanAct(s) or C:Has(s,"Silenced") then return end
    local boss=s.Rank=="Boss"; local elite=s.Rank=="Elite"
    local windup=boss and 1.15 or (elite and 1 or 0.55)
    local radius=boss and (s.Phase==3 and 12 or 8) or (elite and 13 or 5)
    local point=target.Root.Position; s.NextAttack=now+s.Def.Cooldown*(s.Phase==3 and 0.65 or 1)
    s.State="Attack"
    self.S.NetworkService.FX:FireAllClients("Telegraph",Vector3.new(point.X,0.35,point.Z),radius,windup)
    if s.MonsterId=="Lanternwisp" then self.S.NetworkService.FX:FireAllClients("Beam",s.Root.Position,point,"Enemy") end
    task.delay(windup,function()
        if not self.Alive[s] or s.Humanoid.Health<=0 or not self.S.CombatService:CanAct(s) then return end
        local ignore=self.S.SpellService:WorldIgnore()
        for player,state in pairs(self.S.CombatService.States) do
            if state.Humanoid.Health>0 and (state.Root.Position-point).Magnitude<=radius+3
                and not self.S.WorldService:Zone(state.Root.Position).Safe and not self.S.DuelService:IsBusy(player)
                and not self:Protected(player,state.Root.Position)
                and self.S.SpellService:Visible(s.Root.Position,state,ignore) then
                local damage=s.Stats.Damage
                if s.Brood then damage=8 end
                if s.MonsterId=="Moonhowler" and (Lighting.ClockTime>=18 or Lighting.ClockTime<6) then damage=damage*1.3 end
                local reflected=s.MonsterId=="Lanternwisp" and self.S.CombatService:Has(state,"Speculo")
                if reflected then
                    state.Statuses.Speculo=nil
                    self.S.CombatService:Damage(player,s,damage,nil)
                    self.S.NetworkService.FX:FireAllClients("Beam",state.Root.Position,s.Root.Position,"Speculo")
                elseif self.S.CombatService:Damage(nil,state,damage,nil) then
                    if s.Def.Status then self.S.CombatService:Status(state,s.Def.Status,2,nil) end
                    if boss and s.Phase==1 then self.S.CombatService:Status(state,"Rooted",1.2,nil) end
                    if s.MonsterId=="Lanternwisp" then state.Mana=math.max(0,state.Mana-10) end
                end
            end
        end
        self.S.NetworkService.FX:FireAllClients("Blast",point,"Enemy",radius)
        if boss and s.Phase==3 then
            self.S.NetworkService.FX:FireAllClients("Pool",Vector3.new(point.X,0.4,point.Z),radius,5)
            task.spawn(function()
                for _=1,5 do
                    task.wait(1); if not self.Alive[s] then return end
                    for player,state in pairs(self.S.CombatService.States) do
                        if (state.Root.Position-point).Magnitude<radius and not self.S.WorldService:Zone(state.Root.Position).Safe
                            and not self.S.DuelService:IsBusy(player) and not self:Protected(player,state.Root.Position) then self.S.CombatService:Damage(nil,state,8,nil) end
                    end
                end
            end)
        end
    end)
end
function M:Killed(s)
    if not self.Alive[s] then return end
    self.Alive[s]=nil; self.S.CombatService.Targets[s.Model]=nil
    if s.Spawner then s.Spawner.Next=os.clock()+(s.Rank=="Boss" and 600 or (s.Rank=="Elite" and 300 or 30)); s.Spawner.State=nil end
    if not s.Brood then
        for player,contribution in pairs(s.Contributors) do
            local d=self.S.PlayerDataService:Get(player); local root=self.S.WorldService:Root(player)
            if d and root and contribution>0 and (root.Position-s.Root.Position).Magnitude<150 then
                local drop=Loot[s.MonsterId]
                if drop and math.random()<drop.Chance then d.Inventory[drop.Item]=(d.Inventory[drop.Item] or 0)+1 end
                if drop and drop.Tome and math.random()<drop.TomeChance then d.Inventory[drop.Tome.." Tome"]=(d.Inventory[drop.Tome.." Tome"] or 0)+1 end
                if drop and drop.Wand and math.random()<drop.Wand.Chance then self.S.WandService:Reward(player,drop.Wand.Rarity) end
                if drop and drop.Named and math.random()<drop.Named.Chance then self.S.WandService:GrantNamed(player,drop.Named.Id,"A wand was left behind: %s!") end
                if s.MonsterId=="RotbarkSentinel" then d.SealDefeated=true end
                if s.MonsterId=="MotherVexweave" then d.BossDefeated=true; self.S.ProgressionService:HousePoints(player,25) end
                self.S.ProgressionService:Award(player,s.Stats.XP,s.Stats.Gilders)
                self.S.ProgressionService:Event(player,"Kill",s.MonsterId)
                self.S.NetworkService:Notice(player,"+"..s.Stats.XP.." XP   +"..s.Stats.Gilders.." Gilders")
            end
        end
    end
    self.S.NetworkService.FX:FireAllClients("Defeat",s.Root.Position)
    task.delay(0.2,function() s.Model:Destroy() end)
end
function M:Tick(dt)
    for s in pairs(self.Alive) do
        if not s.Model.Parent then self.Alive[s]=nil
        else
            local target=self:Target(s); local hp=s.Humanoid.Health/s.Humanoid.MaxHealth
            if s.Rank=="Boss" then
                s.Phase=hp>0.6 and 1 or (hp>0.25 and 2 or 3); s.Model:SetAttribute("Phase",s.Phase)
                if target and s.Phase==2 and os.clock()>(s.NextBrood or 0) then
                    s.NextBrood=os.clock()+20
                    for i=1,3 do self:Spawn("Gloomspider",s.Home+Vector3.new(i*5-10,0,12),nil,true) end
                end
            end
            if target then
                local distance=(target.Root.Position-s.Root.Position).Magnitude
                if distance>s.Def.Range then s.State="Chase"; self:Move(s,target.Root.Position,dt,s.Def.Speed*(s.Phase==3 and 1.3 or 1))
                else self:Attack(s,target) end
            elseif (s.Root.Position-s.Home).Magnitude>4 then
                s.State="Return"; self:Move(s,s.Home,dt,s.Def.Speed); s.Humanoid.Health=math.min(s.Humanoid.MaxHealth,s.Humanoid.Health+s.Humanoid.MaxHealth*dt/8)
                s.Contributors={}; s.Threat={}
            else
                s.State="Patrol"
                self:Move(s,s.Home+Vector3.new(math.sin(os.clock()/5)*3,0,math.cos(os.clock()/5)*3),dt,3)
                if s.Humanoid.Health<s.Humanoid.MaxHealth then s.Humanoid.Health=math.min(s.Humanoid.MaxHealth,s.Humanoid.Health+s.Humanoid.MaxHealth*dt/8) end
            end
            if s.Brood and os.clock()-s.Born>60 then self.Alive[s]=nil; self.S.CombatService.Targets[s.Model]=nil; s.Model:Destroy() end
        end
    end
    for _,sp in ipairs(self.Spawns) do
        if not sp.State and os.clock()>sp.Next then
            local near=false
            for _,player in ipairs(Players:GetPlayers()) do local root=self.S.WorldService:Root(player); if root and (root.Position-sp.Position).Magnitude<260 then near=true; break end end
            if near then sp.State=self:Spawn(sp.Id,sp.Position,sp,false) end
        end
    end
end
function M:Start()
    local placements={
        {"Thornimp",-65,12},{"Thornimp",-82,33},{"Thornimp",-95,5},{"Thornimp",-76,-17},
        {"Gloomspider",-140,52},{"Gloomspider",-162,70},{"Gloomspider",-137,82},
        {"Lanternwisp",-215,30},{"Lanternwisp",-231,48},{"Lanternwisp",-211,62},
        {"Moonhowler",-207,-65},{"Moonhowler",-229,-88},{"Moonhowler",-190,-84},
        {"RotbarkSentinel",-122,-87},{"MotherVexweave",-160,-183},
    }
    for _,p in ipairs(placements) do self.Spawns[#self.Spawns+1]={Id=p[1],Position=Vector3.new(p[2],0,p[3]),Next=0} end
    task.spawn(function() while true do task.wait(0.2); self:Tick(0.2) end end)
end
return M
]]></ProtectedString>
					<string name="ScriptGuid">{F889C57B-0A4E-4DC8-AD5C-5D6038EA67B8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MonsterService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000768</UniqueId>
				</Properties>
