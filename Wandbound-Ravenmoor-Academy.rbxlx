					<ProtectedString name="Source"><![CDATA[return {
    {Id = "Wand", Title = "The wand chooses you", Hint = "Meet Odric Oakhart in the village.", Kind = "Wand", Need = 1, XP = 60, Gold = 30, Anchor = "Oakhart"},
    {Id = "Sorted", Title = "The Mirror of Choosing", Hint = "Choose your house in the Great Hall.", Kind = "Sorted", Need = 1, XP = 60, Gold = 30, Anchor = "Mirror"},
    {Id = "Lesson", Title = "A first lesson", Hint = "Visit Professor Quill. Trace the rune and hit five lesson targets.", Kind = "Class", Need = 1, XP = 150, Gold = 40, Anchor = "Teacher_Charm"},
    {Id = "Practice", Title = "Find your spark", Hint = "Hit the outdoor training dummies five times.", Kind = "Practice", Need = 5, XP = 150, Gold = 30, Anchor = "Training"},
    {Id = "Tobb", Title = "Whispers at the edge", Hint = "Speak to Tobb near the forest gate.", Kind = "Tobb", Need = 1, XP = 120, Gold = 30, Anchor = "Tobb"},
    {Id = "Thorns", Title = "Clear the path", Hint = "Defeat six Thornimps in Whisperwood.", Kind = "Kill", Target = "Thornimp", Need = 6, XP = 450, Gold = 100, Anchor = "ForestGate"},
    {Id = "Silk", Title = "Threads of the Hollow", Hint = "Defeat five Gloomspiders deeper in the wood.", Kind = "Kill", Target = "Gloomspider", Need = 5, XP = 700, Gold = 150, Anchor = "SpiderClearing"},
    {Id = "Wisps", Title = "The lantern wakes", Hint = "Defeat five Lanternwisps by the Moonwell.", Kind = "Kill", Target = "Lanternwisp", Need = 5, XP = 1100, Gold = 180, Anchor = "Moonwell"},
    {Id = "Howlers", Title = "Under a silver moon", Hint = "Defeat five Moonhowlers. They grow stronger at night.", Kind = "Kill", Target = "Moonhowler", Need = 5, XP = 1500, Gold = 200, Anchor = "HowlerDen"},
    {Id = "Seal", Title = "The Rotbark Seal", Hint = "Defeat the Rotbark Sentinel. Tonitra unlocks at level 15. Reward: the Stormfork wand.", Kind = "Kill", Target = "RotbarkSentinel", Need = 1, XP = 2200, Gold = 300, Anchor = "Rotbark", Wand = "Stormfork"},
    {Id = "Vexweave", Title = "Mother of the Hollow", Hint = "Break Vexweave's hold on the first seal.", Kind = "Kill", Target = "MotherVexweave", Need = 1, XP = 3500, Gold = 500, Anchor = "Vexweave"},
}
