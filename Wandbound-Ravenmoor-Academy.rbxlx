    {Id = "Practice", Title = "Find your spark", Hint = "Hit the outdoor training dummies five times.", Kind = "Practice", Need = 5, XP = 150, Gold = 30, Anchor = "Training"},
    {Id = "Tobb", Title = "Whispers at the edge", Hint = "Speak to Tobb near the forest gate.", Kind = "Tobb", Need = 1, XP = 120, Gold = 30, Anchor = "Tobb"},
