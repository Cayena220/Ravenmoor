		<Item class="Atmosphere" referent="RBX000003A5">
			<Properties>
				<Color3 name="Color">
					<R>0.776470602</R>
					<G>0.835294127</G>
					<B>0.850980401</B>
				</Color3>
				<Color3 name="Decay">
