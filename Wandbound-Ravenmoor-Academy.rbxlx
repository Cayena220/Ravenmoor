			<Item class="ModuleScript" referent="RBX00000393">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local F=require(game:GetService("ReplicatedStorage").Shared.Formulas)
local D={}
function D:Init(services) self.S=services; self.Invites={}; self.Matches={}; self.Rewards={} end
function D:IsBusy(player) return self.Matches[player]~=nil end
function D:IsCounting(player) local m=self.Matches[player]; return m and os.clock()<m.Starts end
function D:CanDamage(a,b)
    local m=self.Matches[a]
    return m~=nil and self.Matches[b]==m and a~=b and not m.Ended and os.clock()>=m.Starts
end
function D:Invite(player,userId)
    if not F.Finite(userId) or userId%1~=0 or self:IsBusy(player) then return end
    local other=Players:GetPlayerByUserId(userId); local a=self.S.CombatService.States[player]; local b=other and self.S.CombatService.States[other]
    if not a or not b or a.Humanoid.Health<=0 or b.Humanoid.Health<=0 or other==player or self:IsBusy(other) then return end
    if not self.S.WorldService:Near(player,"Duelmaster",35) or not self.S.WorldService:Near(other,"Duelmaster",35) then return self.S.NetworkService:Notice(player,"Both duelists must stand near Duelmaster Vey.") end
    local invite=self.Invites[other]
    if invite and os.clock()<invite.Expires then return self.S.NetworkService:Notice(player,"That student already has an invitation.") end
    self.Invites[other]={From=player,Expires=os.clock()+20}
    self.S.NetworkService.UI:FireClient(other,"DuelInvite",{Name=player.DisplayName,UserId=player.UserId})
    self.S.NetworkService:Notice(player,"Duel invitation sent.")
end
function D:Respond(player,accept)
    local invite=self.Invites[player]; self.Invites[player]=nil
    if type(accept)~="boolean" or not invite or invite.Expires<os.clock() or not accept then return end
    if self.Active and not self.Active.Ended then return self.S.NetworkService:Notice(player,"The dueling platform is occupied. Try again after this match.") end
    local other=invite.From
    if not other.Parent or self:IsBusy(player) or self:IsBusy(other) then return end
    if not self.S.WorldService:Near(player,"Duelmaster",35) or not self.S.WorldService:Near(other,"Duelmaster",35) then return end
    local a=self.S.CombatService.States[player]; local b=self.S.CombatService.States[other]
    if not a or not b or a.Humanoid.Health<=0 or b.Humanoid.Health<=0 then return end
    local m={Players={player,other},Starts=os.clock()+3,Ends=os.clock()+183,Positions={[player]=a.Root.Position,[other]=b.Root.Position}}
    self.Active=m
    self.Matches[player]=m; self.Matches[other]=m
    for i,p in ipairs(m.Players) do
        self.S.ClassService:Cancel(p)
        local s=self.S.CombatService.States[p]; s.Humanoid.Health=s.Humanoid.MaxHealth; s.Mana=s.MaxMana; s.Stamina=100; s.Statuses={}; s.Shield=0; s.Cooldowns={}; s.InvulnerableUntil=m.Starts
        self.S.WorldService:Teleport(p,Vector3.new(240,5,i==1 and -120 or -170))
        self.S.NetworkService.UI:FireClient(p,"DuelStart",3)
    end
end
function D:Finish(m,winner)
    if m.Ended then return end; m.Ended=true
    if self.Active==m then self.Active=nil end
    for _,p in ipairs(m.Players) do
        self.Matches[p]=nil
        local s=self.S.CombatService.States[p]
        if s and p.Parent then
            s.Statuses={}; s.Shield=0; s.Cooldowns={}; s.Humanoid.Health=s.Humanoid.MaxHealth; s.Mana=s.MaxMana; s.InvulnerableUntil=os.clock()+5
            self.S.WorldService:Teleport(p,m.Positions[p])
            self.S.NetworkService:Notice(p,winner and (winner==p and "Duel won!" or "Duel lost. Train, adapt, return.") or "Duel ended in a draw.")
        end
    end
    if winner then
        local d=self.S.PlayerDataService:Get(winner)
        if d then
            d.DuelWins=d.DuelWins+1
            local rewards=self.Rewards[winner] or {Hour=math.floor(os.time()/3600),Count=0}; self.Rewards[winner]=rewards
            if rewards.Hour~=math.floor(os.time()/3600) then rewards.Hour=math.floor(os.time()/3600); rewards.Count=0 end
            if rewards.Count<10 then
                rewards.Count=rewards.Count+1; self.S.ProgressionService:HousePoints(winner,5)
                local perk=d.House=="Nightfang" and 1.05 or 1
                self.S.ProgressionService:Award(winner,math.floor(80*perk),math.floor(20*perk))
            end
            self.S.ProgressionService:Refresh(winner)
        end
    end
end
function D:Defeated(player)
    local m=self.Matches[player]; if not m then return end
    local winner=m.Players[1]==player and m.Players[2] or m.Players[1]
    self:Finish(m,winner)
end
function D:Start()
    self.S.NetworkService.Handlers.DuelInvite=function(player,id) self:Invite(player,id) end
    self.S.NetworkService.Handlers.DuelRespond=function(player,accept) self:Respond(player,accept) end
    Players.PlayerRemoving:Connect(function(player) self:Defeated(player); self.Invites[player]=nil; self.Rewards[player]=nil end)
    task.spawn(function()
        while true do
            task.wait(1)
            for player,m in pairs(self.Matches) do
                local root=self.S.WorldService:Root(player)
                if os.clock()>m.Ends then self:Finish(m,nil)
                elseif root and (math.abs(root.Position.X-240)>39 or math.abs(root.Position.Z+145)>45) then self:Defeated(player) end
            end
            for player,inv in pairs(self.Invites) do if not player.Parent or not inv.From.Parent or os.clock()>inv.Expires then self.Invites[player]=nil end end
        end
    end)
end
return D
]]></ProtectedString>
					<string name="ScriptGuid">{2CB0F5E0-3D57-4E5C-8AD3-38546ED9D42E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DuelService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000766</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000394">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.Config)
local F=require(RS.Shared.Formulas)
local Wands=require(RS.Shared.WandData)
local Quests=require(RS.Shared.QuestData)
local I={}
function I:Init(services) self.S=services; self.PotionCooldowns={}; self.Interactions={} end
local advice={
    Oakhart="Open your bag with B to equip a wand. Use K to assign learned spells to 1–4. Right mouse raises your ward; left mouse casts Scintara.",
    Tobb="Watch for red attack circles in Whisperwood. Shift dodges. Bring Thorn Barbs and Spider Silk to the apothecary to brew Health Draughts.",
    Bank="Your vault keeps Gilders separate from your spending money. Deposits and withdrawals are available here.",
    Apothecary="A Thorn Barb and Spider Silk make one Health Draught. Use it from your bag to recover health over four seconds.",
    Duelmaster="Bring another student here for a friendly duel. Both players must accept. You keep your items, and matches end before a lethal hit.",
}
function I:Interact(player,name,choice)
    if type(name)~="string" or type(choice)~="string" then return end
    local npc=self.Interactions[name]; local d=self.S.PlayerDataService:Get(player)
    if not npc or not d or not self.S.WorldService:Near(player,name,15) or self.S.DuelService:IsBusy(player) then return end
    if choice=="Service" then return npc.Callback(player) end
    local message
    if choice=="Advice" then message=advice[name] or "Receive your wand, choose a house, then ask a professor for a lesson. Trace the rune and hit five targets with Scintara."
    elseif choice=="Quest" then local q=Quests[d.Quest]; message=q and (q.Title..": "..q.Hint) or "You have completed the first story. Explore the woods, practise spells, and try a friendly duel."
    elseif choice=="Hello" then message="Welcome, student. What can I help you with?"
    else return end
    self.S.NetworkService.UI:FireClient(player,"Dialogue",{Anchor=name,Name=npc.Name,Text=message,
        Choices={{Id="Service",Label=npc.Action},{Id="Advice",Label="Do you have any advice?"},{Id="Quest",Label="What should I do next?"}}})
end
function I:Prompt(name,label,action,callback)
    local conversational=name~="Mirror" and not name:match("^Waystone_")
    if conversational then self.Interactions[name]={Name=label,Action=action,Callback=callback} end
    local anchor=self.S.WorldService:Anchor(name); if not anchor then warn("Missing interaction",name); return end
    local prompt=Instance.new("ProximityPrompt"); prompt.Name="Interact"; prompt.ObjectText=label; prompt.ActionText=conversational and "Talk" or action
    prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.GamepadKeyCode=Enum.KeyCode.ButtonX
    prompt.MaxActivationDistance=12; prompt.HoldDuration=0.2; prompt.RequiresLineOfSight=false; prompt.Parent=anchor
    prompt.Triggered:Connect(function(player)
        if self.S.WorldService:Near(player,anchor,15) and self.S.PlayerDataService:Get(player)
            and not self.S.DuelService:IsBusy(player) and self.S.NetworkService:Allow(player,"Prompt",3,5) then
                if conversational then self:Interact(player,name,"Hello") else callback(player) end
            end
    end)
end
function I:Unseal(player,part)
    local chest=part
    while chest and chest.Parent~=workspace.Map do
        if chest:GetAttribute("ChestId") then break end
        chest=chest.Parent
    end
    if not chest or not chest:GetAttribute("ChestId") then return end
    local id=chest:GetAttribute("ChestId"); local root=self.S.WorldService:Root(player); local pos=chest:GetPivot().Position
    if not root or (root.Position-pos).Magnitude>35 then return end
    local d=self.S.PlayerDataService:Get(player); if not d then return end
    d.Chests=d.Chests or {}
    if os.time()-(d.Chests[id] or 0)<300 then return self.S.NetworkService:Notice(player,"This chest will refill in five minutes.") end
    d.Chests[id]=os.time(); self.S.ProgressionService:Award(player,25,35)
    self.S.NetworkService:Notice(player,"Unsealed chest · +35 Gilders")
    self.S.NetworkService.FX:FireAllClients("Blast",pos,"Aegara",4)
end
function I:Start()
    self.S.NetworkService.Handlers.Interact=function(player,name,choice) self:Interact(player,name,choice) end
    self:Prompt("Oakhart","Odric Oakhart","Wands",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.HasWand then self.S.WandService:Deliver(player); return self.S.NetworkService.UI:FireClient(player,"Wandery") end
        local wand=Wands.Roll("Common")
        d.HasWand=true; self.S.WandService:Grant(player,wand)
        for _,id in ipairs({"Scintara","Aegara","Glimmora"}) do self.S.ProgressionService:Learn(player,id,true) end
        self.S.ProgressionService:Event(player,"Wand")
        self.S.NetworkService:Notice(player,"The wand chooses you: "..Wands.Name(wand)..". Scintara, Aegara and Glimmora are yours.")
    end)
    self:Prompt("Mirror","Mirror of Choosing","Discover your house",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d.HasWand then return self.S.NetworkService:Notice(player,"Visit Oakhart's Wandery first.") end
        if d.House~="" then return self.S.NetworkService:Notice(player,"You belong to "..d.House..". "..Config.Houses[d.House].Perk) end
        self.S.NetworkService.UI:FireClient(player,"Sorting")
    end)
    for school,teacher in pairs(Config.Teachers) do
        self:Prompt(teacher.Anchor,teacher.Name,"Practice "..teacher.Title,function(player) self.S.ClassService:Begin(player,school) end)
    end
    self:Prompt("Tobb","Tobb Brambleworth","Ask about Whisperwood",function(player)
        self.S.ProgressionService:Event(player,"Tobb")
        self.S.NetworkService:Notice(player,"Thornimps are swarming the woodland path. Watch the red attack circles, and dodge!")
    end)
    self:Prompt("Bank","Vaultkeep Bank","Open vault",function(player) self.S.NetworkService.UI:FireClient(player,"Bank") end)
    self:Prompt("Apothecary","Hollowmere Apothecary","Shop & brew",function(player) self.S.NetworkService.UI:FireClient(player,"Shop") end)
    self:Prompt("Library","Restricted Shelf","Study the archive",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.Level>=14 then self.S.ProgressionService:Learn(player,"Tractum",false)
        else self.S.NetworkService:Notice(player,"Return at level 14 to study Tractum.") end
        self.S.NetworkService.UI:FireClient(player,"Library")
    end)
    self:Prompt("Duelmaster","Duelmaster Kestrel Vey","Open Dueling Club",function(player)
        local d=self.S.PlayerDataService:Get(player)
        if d.Level>=6 then self.S.ProgressionService:Learn(player,"Excido",false) end
        self.S.NetworkService.UI:FireClient(player,"Duels")
    end)
    for id in pairs(Config.Waystones) do
        self:Prompt("Waystone_"..id,id.." Waystone","Attune / travel",function(player)
            local d=self.S.PlayerDataService:Get(player); d.Waystones[id]=true; d.LastWaystone=id
            self.S.ProgressionService:Refresh(player); self.S.NetworkService.UI:FireClient(player,"Map")
        end)
    end
    self.S.NetworkService.Handlers.Sort=function(player,answers,choice)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not d.HasWand or d.House~="" or type(answers)~="table" or #answers~=5 or type(choice)~="string" or not Config.Houses[choice] then return end
        if not self.S.WorldService:Near(player,"Mirror",18) then return end
        for _,v in ipairs(answers) do if not F.Finite(v) or v%1~=0 or v<1 or v>4 then return end end
        d.House=choice; self.S.ProgressionService:Event(player,"Sorted"); self.S.CombatService:UpdateStats(player,true)
        self.S.NetworkService:Notice(player,"Welcome to "..choice.."!")
    end
    self.S.NetworkService.Handlers.Bank=function(player,action,amount)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Bank",15) or self.S.DuelService:IsBusy(player)
            or not F.Finite(amount) or amount%1~=0 or amount<1 or amount>1000000 then return end
        if action=="Deposit" and d.Gilders>=amount then d.Gilders=d.Gilders-amount; d.BankGilders=d.BankGilders+amount
        elseif action=="Withdraw" and d.BankGilders>=amount then d.BankGilders=d.BankGilders-amount; d.Gilders=d.Gilders+amount
        else return self.S.NetworkService:Notice(player,"Not enough Gilders.") end
        self.S.ProgressionService:Refresh(player); self.S.NetworkService:Notice(player,"Vault balance: "..d.BankGilders.." Gilders")
    end
    self.S.NetworkService.Handlers.Shop=function(player,action)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Apothecary",15) or self.S.DuelService:IsBusy(player) then return end
        if action=="BuyHealth" then
            if d.Gilders<50 then return self.S.NetworkService:Notice(player,"A Health Draught costs 50 Gilders.") end
            d.Gilders=d.Gilders-50; d.Inventory["Health Draught"]=(d.Inventory["Health Draught"] or 0)+1
        elseif action=="BrewHealth" then
            if (d.Inventory["Thorn Barb"] or 0)<1 or (d.Inventory["Spider Silk"] or 0)<1 then return self.S.NetworkService:Notice(player,"You need one Thorn Barb and one Spider Silk.") end
            d.Inventory["Thorn Barb"]=d.Inventory["Thorn Barb"]-1; d.Inventory["Spider Silk"]=d.Inventory["Spider Silk"]-1
            d.Inventory["Health Draught"]=(d.Inventory["Health Draught"] or 0)+1
        else return end
        self.S.ProgressionService:Refresh(player); self.S.NetworkService:Notice(player,"Health Draught added to your bag.")
    end
    self.S.NetworkService.Handlers.UseItem=function(player,id)
        local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
        if type(id)~="string" or not d or not self.S.CombatService:CanAct(s) or self.S.DuelService:IsBusy(player) or (d.Inventory[id] or 0)<1 then return end
        if id=="Health Draught" then
            if os.clock()<(self.PotionCooldowns[player] or 0) then return self.S.NetworkService:Notice(player,"Potions share a 30-second cooldown.") end
            if s.Humanoid.Health>=s.Humanoid.MaxHealth then return self.S.NetworkService:Notice(player,"Your health is already full.") end
            self.PotionCooldowns[player]=os.clock()+30; d.Inventory[id]=d.Inventory[id]-1
            task.spawn(function()
                for _=1,4 do task.wait(1); if self.S.CombatService.States[player]~=s or s.Humanoid.Health<=0 or self.S.DuelService:IsBusy(player) then return end; self.S.CombatService:Heal(player,s,s.Humanoid.MaxHealth*0.1) end
            end)
        elseif id=="Frigora Tome" or id=="Somnara Tome" then
            if self.S.ProgressionService:Learn(player,id:gsub(" Tome$",""),false) then d.Inventory[id]=d.Inventory[id]-1
            else return self.S.NetworkService:Notice(player,"You must meet the spell's level requirement and not already know it.") end
        else return end
        self.S.ProgressionService:Refresh(player)
    end
    self.S.NetworkService.Handlers.Respec=function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Library",15) or self.S.DuelService:IsBusy(player) then return end
        local day=math.floor(os.time()/86400)
        if d.LastRespec==day then return self.S.NetworkService:Notice(player,"Your next free respec is available tomorrow (UTC).") end
        d.LastRespec=day; d.Attributes={Power=0,Focus=0,Vitality=0,Agility=0,Unspent=(d.Level-1)*2}
        self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
    end
    self.S.NetworkService.Handlers.TalentReset=function(player)
        local d=self.S.PlayerDataService:Get(player)
        if not d or not self.S.WorldService:Near(player,"Library",15) or self.S.DuelService:IsBusy(player) then return end
        local day=math.floor(os.time()/86400)
        if d.LastTalentReset==day then return self.S.NetworkService:Notice(player,"Your next free skill reset is available tomorrow (UTC).") end
        d.LastTalentReset=day; d.Talents={}
        self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
        self.S.NetworkService:Notice(player,"All skill points refunded.")
    end
    for i=1,3 do
        local model=Instance.new("Model"); model.Name="Training Dummy"
        local root=Instance.new("Part"); root.Name="HumanoidRootPart"; root.Size=Vector3.new(3,5,2); root.Position=Vector3.new(156+(i-1)*9,3,-10)
        root.Anchored=true; root.Material=Enum.Material.Wood; root.Color=Color3.fromRGB(155,118,75); root.Parent=model; model.PrimaryPart=root
        local hum=Instance.new("Humanoid"); hum.RequiresNeck=false; hum.MaxHealth=100000; hum.Health=100000; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
        model.Parent=self.S.WorldService.Targets; self.S.CombatService:Register(model,{Dummy=true})
    end
    for i=1,3 do
        local chest=workspace.Map:FindFirstChild("RuneChest"..i,true); if chest then chest:SetAttribute("ChestId","Chest"..i) end
    end
    Players.PlayerRemoving:Connect(function(player) self.PotionCooldowns[player]=nil end)
end
return I
]]></ProtectedString>
					<string name="ScriptGuid">{8229A4DB-8A22-487D-98DC-140569A8949A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">InteractionService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000767</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000395">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local RS=game:GetService("ReplicatedStorage")
local Data=require(RS.Shared.MonsterData)
local F=require(RS.Shared.Formulas)
local Config=require(RS.Shared.Config)
local Loot=require(game:GetService("ServerStorage").LootTables)
local M={}
local function part(parent,name,size,cf,color,shape)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape then p.Shape=shape end
    p.Parent=parent; return p
end
function M:Init(services) self.S=services; self.Spawns={}; self.Alive={}; self.NextId=0 end
function M:Count() local count=0; for _ in pairs(self.Alive) do count=count+1 end; return count end
function M:Spawn(id,pos,spawner,brood)
    if self:Count()>=Config.MaxMonsters then return end
    local def=Data[id]; local stat=F.Monster(def.Level,def.Rank); local size=brood and 1.7 or def.Size
    local model=Instance.new("Model"); model.Name=def.Name; local color=Color3.fromRGB(table.unpack(def.Color))
    local y=def.Flying and 6 or size/2+0.5; local position=Vector3.new(pos.X,y,pos.Z)
    local root=part(model,"HumanoidRootPart",Vector3.new(size,size,size),CFrame.new(position),color,Enum.PartType.Ball)
    model.PrimaryPart=root
    for side=-1,1,2 do
        part(model,"Eye",Vector3.new(size*0.15,size*0.17,size*0.1),CFrame.new(position+Vector3.new(side*size*0.2,size*0.1,-size*0.46)),Color3.fromRGB(249,206,113)).Material=Enum.Material.Neon
    end
    if id=="Gloomspider" or id=="MotherVexweave" then
        for side=-1,1,2 do for leg=1,4 do
            part(model,"Leg",Vector3.new(size*0.9,0.3,size*0.12),CFrame.new(position+Vector3.new(side*size*0.65,-size*0.2,(leg-2.5)*size*0.24))*CFrame.Angles(0,side*(leg-2.5)*0.3,side*0.2),color)
        end end
    elseif id=="RotbarkSentinel" then
        for side=-1,1,2 do part(model,"Branch",Vector3.new(1,size*1.2,1),CFrame.new(position+Vector3.new(side*size*0.7,1,0))*CFrame.Angles(0,0,side*0.5),color) end
    elseif id=="Lanternwisp" then root.Material=Enum.Material.Neon end
    local hum=Instance.new("Humanoid"); hum.RequiresNeck=false; hum.BreakJointsOnDeath=false; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    hum.MaxHealth=brood and 55 or stat.HP; hum.Health=hum.MaxHealth; hum.Parent=model
    model.Parent=self.S.WorldService.Monsters
    local state=self.S.CombatService:Register(model,{MonsterId=id,Rank=def.Rank,Def=def,Stats=stat,Home=position,Size=size,
        Spawner=spawner,Threat={},Contributors={},NextAttack=0,Phase=1,Brood=brood,State="Idle",Born=os.clock()})
    model:SetAttribute("MonsterId",id); model:SetAttribute("Level",def.Level); model:SetAttribute("Rank",def.Rank)
    self.Alive[state]=true; return state
end
function M:Target(s)
    local best,bestScore=nil,-math.huge
    for _,player in ipairs(Players:GetPlayers()) do
        local target=self.S.CombatService.States[player]
        if target and target.Humanoid.Health>0 and not self.S.WorldService:Zone(target.Root.Position).Safe and not self.S.DuelService:IsBusy(player) then
            local distance=(target.Root.Position-s.Root.Position).Magnitude
            local homeDistance=(target.Root.Position-s.Home).Magnitude
            if distance<((s.Threat[player] or 0)>0 and 80 or 30) and homeDistance<90 then
                local score=(s.Threat[player] or 0)+30-distance
                if score>bestScore then best=target; bestScore=score end
            end
        end
    end
    return best
end
function M:Move(s,destination,dt,speed)
    local C=self.S.CombatService
    if C:Has(s,"Rooted") or not C:CanAct(s) then return end
    local delta=(destination-s.Root.Position)*Vector3.new(1,0,1)
    if delta.Magnitude<1 then return end
    local amount=math.min(delta.Magnitude,speed*dt*(C:Has(s,"Chilled") and 0.7 or 1))
    local dir=delta.Unit
    local params=self.S.SpellService:Params(self.S.SpellService:WorldIgnore())
    local radius=math.min(1.5,s.Size/2)
    local hit=workspace:Spherecast(s.Root.Position,radius,dir*(amount+1),params)
    if hit then
        dir=Vector3.new(-dir.Z,0,dir.X)
        if workspace:Spherecast(s.Root.Position,math.min(1.2,radius),dir*(amount+1),params) then return end
    end
    local p=s.Root.Position+dir*amount
    if s.Def.Flying then p=Vector3.new(p.X,6+math.sin(os.clock()*2)*0.6,p.Z) end
    s.Model:PivotTo(CFrame.lookAt(p,p+dir))
end
function M:Protected(player,position)
    for _,d in ipairs(self.S.SpellService.Domes) do if d.Player==player and d.Until>os.clock() and (d.Pos-position).Magnitude<10 then return true end end
    return false
end
function M:Attack(s,target)
    local C=self.S.CombatService
    local now=os.clock(); if now<s.NextAttack or not C:CanAct(s) or C:Has(s,"Silenced") then return end
    local boss=s.Rank=="Boss"; local elite=s.Rank=="Elite"
    local windup=boss and 1.15 or (elite and 1 or 0.55)
    local radius=boss and (s.Phase==3 and 12 or 8) or (elite and 13 or 5)
    local point=target.Root.Position; s.NextAttack=now+s.Def.Cooldown*(s.Phase==3 and 0.65 or 1)
    s.State="Attack"
    self.S.NetworkService.FX:FireAllClients("Telegraph",Vector3.new(point.X,0.35,point.Z),radius,windup)
    if s.MonsterId=="Lanternwisp" then self.S.NetworkService.FX:FireAllClients("Beam",s.Root.Position,point,"Enemy") end
    task.delay(windup,function()
        if not self.Alive[s] or s.Humanoid.Health<=0 or not self.S.CombatService:CanAct(s) then return end
        local ignore=self.S.SpellService:WorldIgnore()
        for player,state in pairs(self.S.CombatService.States) do
            if state.Humanoid.Health>0 and (state.Root.Position-point).Magnitude<=radius+3
                and not self.S.WorldService:Zone(state.Root.Position).Safe and not self.S.DuelService:IsBusy(player)
                and not self:Protected(player,state.Root.Position)
                and self.S.SpellService:Visible(s.Root.Position,state,ignore) then
                local damage=s.Stats.Damage
                if s.Brood then damage=8 end
                if s.MonsterId=="Moonhowler" and (Lighting.ClockTime>=18 or Lighting.ClockTime<6) then damage=damage*1.3 end
                local reflected=s.MonsterId=="Lanternwisp" and self.S.CombatService:Has(state,"Speculo")
                if reflected then
                    state.Statuses.Speculo=nil
                    self.S.CombatService:Damage(player,s,damage,nil)
                    self.S.NetworkService.FX:FireAllClients("Beam",state.Root.Position,s.Root.Position,"Speculo")
                elseif self.S.CombatService:Damage(nil,state,damage,nil) then
                    if s.Def.Status then self.S.CombatService:Status(state,s.Def.Status,2,nil) end
                    if boss and s.Phase==1 then self.S.CombatService:Status(state,"Rooted",1.2,nil) end
                    if s.MonsterId=="Lanternwisp" then state.Mana=math.max(0,state.Mana-10) end
                end
            end
        end
        self.S.NetworkService.FX:FireAllClients("Blast",point,"Enemy",radius)
        if boss and s.Phase==3 then
            self.S.NetworkService.FX:FireAllClients("Pool",Vector3.new(point.X,0.4,point.Z),radius,5)
            task.spawn(function()
                for _=1,5 do
                    task.wait(1); if not self.Alive[s] then return end
                    for player,state in pairs(self.S.CombatService.States) do
                        if (state.Root.Position-point).Magnitude<radius and not self.S.WorldService:Zone(state.Root.Position).Safe
                            and not self.S.DuelService:IsBusy(player) and not self:Protected(player,state.Root.Position) then self.S.CombatService:Damage(nil,state,8,nil) end
                    end
                end
            end)
        end
    end)
end
function M:Killed(s)
    if not self.Alive[s] then return end
    self.Alive[s]=nil; self.S.CombatService.Targets[s.Model]=nil
    if s.Spawner then s.Spawner.Next=os.clock()+(s.Rank=="Boss" and 600 or (s.Rank=="Elite" and 300 or 30)); s.Spawner.State=nil end
    if not s.Brood then
        for player,contribution in pairs(s.Contributors) do
            local d=self.S.PlayerDataService:Get(player); local root=self.S.WorldService:Root(player)
            if d and root and contribution>0 and (root.Position-s.Root.Position).Magnitude<150 then
                local drop=Loot[s.MonsterId]
                if drop and math.random()<drop.Chance then d.Inventory[drop.Item]=(d.Inventory[drop.Item] or 0)+1 end
                if drop and drop.Tome and math.random()<drop.TomeChance then d.Inventory[drop.Tome.." Tome"]=(d.Inventory[drop.Tome.." Tome"] or 0)+1 end
                if drop and drop.Wand and math.random()<drop.Wand.Chance then self.S.WandService:Reward(player,drop.Wand.Rarity) end
                if drop and drop.Named and math.random()<drop.Named.Chance then self.S.WandService:GrantNamed(player,drop.Named.Id,"A wand was left behind: %s!") end
                if s.MonsterId=="RotbarkSentinel" then d.SealDefeated=true end
                if s.MonsterId=="MotherVexweave" then d.BossDefeated=true; self.S.ProgressionService:HousePoints(player,25) end
                self.S.ProgressionService:Award(player,s.Stats.XP,s.Stats.Gilders)
                self.S.ProgressionService:Event(player,"Kill",s.MonsterId)
                self.S.NetworkService:Notice(player,"+"..s.Stats.XP.." XP   +"..s.Stats.Gilders.." Gilders")
            end
        end
    end
    self.S.NetworkService.FX:FireAllClients("Defeat",s.Root.Position)
    task.delay(0.2,function() s.Model:Destroy() end)
end
function M:Tick(dt)
    for s in pairs(self.Alive) do
        if not s.Model.Parent then self.Alive[s]=nil
        else
            local target=self:Target(s); local hp=s.Humanoid.Health/s.Humanoid.MaxHealth
            if s.Rank=="Boss" then
                s.Phase=hp>0.6 and 1 or (hp>0.25 and 2 or 3); s.Model:SetAttribute("Phase",s.Phase)
                if target and s.Phase==2 and os.clock()>(s.NextBrood or 0) then
                    s.NextBrood=os.clock()+20
                    for i=1,3 do self:Spawn("Gloomspider",s.Home+Vector3.new(i*5-10,0,12),nil,true) end
                end
            end
            if target then
                local distance=(target.Root.Position-s.Root.Position).Magnitude
                if distance>s.Def.Range then s.State="Chase"; self:Move(s,target.Root.Position,dt,s.Def.Speed*(s.Phase==3 and 1.3 or 1))
                else self:Attack(s,target) end
            elseif (s.Root.Position-s.Home).Magnitude>4 then
                s.State="Return"; self:Move(s,s.Home,dt,s.Def.Speed); s.Humanoid.Health=math.min(s.Humanoid.MaxHealth,s.Humanoid.Health+s.Humanoid.MaxHealth*dt/8)
                s.Contributors={}; s.Threat={}
            else
                s.State="Patrol"
                self:Move(s,s.Home+Vector3.new(math.sin(os.clock()/5)*3,0,math.cos(os.clock()/5)*3),dt,3)
                if s.Humanoid.Health<s.Humanoid.MaxHealth then s.Humanoid.Health=math.min(s.Humanoid.MaxHealth,s.Humanoid.Health+s.Humanoid.MaxHealth*dt/8) end
            end
            if s.Brood and os.clock()-s.Born>60 then self.Alive[s]=nil; self.S.CombatService.Targets[s.Model]=nil; s.Model:Destroy() end
        end
    end
    for _,sp in ipairs(self.Spawns) do
        if not sp.State and os.clock()>sp.Next then
            local near=false
            for _,player in ipairs(Players:GetPlayers()) do local root=self.S.WorldService:Root(player); if root and (root.Position-sp.Position).Magnitude<260 then near=true; break end end
            if near then sp.State=self:Spawn(sp.Id,sp.Position,sp,false) end
        end
    end
end
function M:Start()
    local placements={
        {"Thornimp",-65,12},{"Thornimp",-82,33},{"Thornimp",-95,5},{"Thornimp",-76,-17},
        {"Gloomspider",-140,52},{"Gloomspider",-162,70},{"Gloomspider",-137,82},
        {"Lanternwisp",-215,30},{"Lanternwisp",-231,48},{"Lanternwisp",-211,62},
        {"Moonhowler",-207,-65},{"Moonhowler",-229,-88},{"Moonhowler",-190,-84},
        {"RotbarkSentinel",-122,-87},{"MotherVexweave",-160,-183},
    }
    for _,p in ipairs(placements) do self.Spawns[#self.Spawns+1]={Id=p[1],Position=Vector3.new(p[2],0,p[3]),Next=0} end
    task.spawn(function() while true do task.wait(0.2); self:Tick(0.2) end end)
end
return M
]]></ProtectedString>
					<string name="ScriptGuid">{F889C57B-0A4E-4DC8-AD5C-5D6038EA67B8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MonsterService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000768</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000396">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local N = {}
function N:Init(services)
    self.S = services; self.Buckets = {}; self.Handlers = {}
    self.Folder = Instance.new("Folder"); self.Folder.Name = "Remotes"; self.Folder.Parent = RS
    for _, name in ipairs({"Cast", "Action", "Gesture", "Profile", "State", "UI", "CastReply"}) do
        local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = self.Folder; self[name] = r
    end
    for _, name in ipairs({"Aim", "FX"}) do
        local r = Instance.new("UnreliableRemoteEvent"); r.Name = name; r.Parent = self.Folder; self[name] = r
    end
end
function N:Allow(player, key, rate, burst)
    local user = self.Buckets[player] or {}; self.Buckets[player] = user
    local t = os.clock(); local b = user[key] or {Time = t, Tokens = burst}; user[key] = b
    b.Tokens = math.min(burst, b.Tokens + (t-b.Time)*rate); b.Time = t
    if b.Tokens < 1 then return false end
    b.Tokens = b.Tokens-1; return true
end
function N:Bind(name, rate, burst, callback)
    self[name].OnServerEvent:Connect(function(player, ...)
        if not self:Allow(player, name, rate, burst) then return end
        callback(player, ...)
    end)
end
function N:Notice(player, text)
    if player.Parent then self.UI:FireClient(player, "Toast", text) end
end
function N:Sync(player)
    local data = self.S.PlayerDataService:Get(player)
    if data and player.Parent then self.Profile:FireClient(player, data) end
end
function N:Start()
    self:Bind("Action", 5, 10, function(player, action, a, b)
        if type(action) ~= "string" or #action > 32 then return end
        local fn = self.Handlers[action]; if fn then fn(player, a, b) end
    end)
    self.Handlers.Ready = function(player) self:Sync(player) end
    Players.PlayerRemoving:Connect(function(player) self.Buckets[player] = nil end)
end
return N
]]></ProtectedString>
					<string name="ScriptGuid">{6FB65852-D2DE-4AF3-87A0-8E5FB2ADF6A9}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">NetworkService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000769</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000397">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local SpellData = require(Shared.SpellData)
local WandData = require(Shared.WandData)
local SkillData = require(Shared.SkillData)
local D = {}
local function clone(value)
    if type(value) ~= "table" then return value end
    local copy = {}; for k,v in pairs(value) do copy[k] = clone(v) end; return copy
end
local function template()
    return {Version = 1, Level = 1, XP = 0, House = "", HousePoints = 0, Gilders = 0, BankGilders = 0,
        Attributes = {Power = 0, Focus = 0, Vitality = 0, Agility = 0, Unspent = 0},
        Spells = {}, Loadout = {Ward = "Aegara", Slot1 = "Glimmora", Slot2 = "", Slot3 = "", Slot4 = ""},
        HasWand = false, Wand = "", Quest = 1, QuestProgress = 0, QuestDone = {},
        Inventory = {}, Combos = {}, LastWaystone = "Hollowmere", Waystones = {Hollowmere = true},
        Daily = {Day = 0, Kills = 0, Claimed = false}, DuelWins = 0,
        Settings = {SpokenCasting = true, ReducedEffects = false},
        BossDefeated = false, SealDefeated = false, LessonRewards = {}, LastRespec = 0,
        Wands = {}, EquippedWand = 0, WandsHeld = {}, WandRewards = {}, Talents = {}, LastTalentReset = 0}
end
local function reconcile(data, defaults)
    for k,v in pairs(defaults) do
        if data[k] == nil or type(data[k]) ~= type(v) then data[k] = clone(v)
        elseif type(v) == "table" then reconcile(data[k], v) end
    end
end
function D:Init(services)
    self.S = services; self.Profiles = {}; self.Loading = {}; self.Closing = false
    self.SessionId = game.JobId ~= "" and game.JobId or HttpService:GenerateGUID(false)
    self.Ephemeral = RunService:IsStudio() and not Config.StudioSaves
    if not self.Ephemeral then self.Store = DataStoreService:GetDataStore(Config.DataStoreName) end
end
function D:Get(player)
    local p = self.Profiles[player]
    if p and not p.Closing then return p.Data end
    return nil
end
function D:Load(player)
    if self.Loading[player] or self.Profiles[player] or self.Closing then return end
    self.Loading[player] = true
    local data
    if self.Ephemeral then data = template() else
        for attempt = 1, 3 do
            local ok, result = pcall(function()
                return self.Store:UpdateAsync("Player_" .. player.UserId, function(old)
                    if old and old.Session and old.Session.Id ~= self.SessionId and old.Session.Expires > os.time() then return nil end
                    return {Data = old and old.Data or template(), Session = {Id = self.SessionId, Expires = os.time() + Config.LockLifetime}}
                end)
            end)
            if ok and result and result.Session and result.Session.Id == self.SessionId then data = result.Data; break end
            if attempt < 3 then task.wait(attempt * 2) end
        end
    end
    self.Loading[player] = nil
    if not data then
        if player.Parent then player:Kick("Your progress could not be opened safely. Please rejoin in a moment.") end
        return
    end
    reconcile(data, template())
    data.Level = math.clamp(math.floor(data.Level), 1, Config.LevelCap)
    for id in pairs(data.Spells) do if not SpellData[id] then data.Spells[id] = nil end end
    WandData.Sanitize(data); SkillData.Sanitize(data)
    local profile = {Data = data, SavedAt = os.time(), Busy = false, Closing = false}
    self.Profiles[player] = profile
    if not player.Parent or self.Closing then self:Release(player); return end
    player:SetAttribute("SessionOnly", self.Ephemeral)
    player:SetAttribute("DataReady", true)
    local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
    for _, name in ipairs({"Level", "Gilders", "HousePoints"}) do local v = Instance.new("IntValue"); v.Name = name; v.Value = data[name]; v.Parent = stats end
    self.S.ProgressionService:Refresh(player)
    self.S.CombatService:BindPlayer(player)
    player:LoadCharacterAsync()
    self.S.NetworkService:Sync(player)
end
function D:Save(player, release)
    local p = self.Profiles[player]; if not p then return true end
    local deadline = os.clock() + 22
    while p.Busy and os.clock() < deadline do task.wait(0.1) end
    if p.Busy then return false end
    p.Busy = true
    if self.Ephemeral then p.Busy = false; return true end
    local snapshot = clone(p.Data)
    local success = false
    for attempt = 1, 3 do
        local ok, result = pcall(function()
            return self.Store:UpdateAsync("Player_" .. player.UserId, function(old)
                -- Never overwrite a profile whose lock another server owns.
                if not old or not old.Session or old.Session.Id ~= self.SessionId then return nil end
                local nextSession = nil
                if not release then nextSession = {Id = self.SessionId, Expires = os.time() + Config.LockLifetime} end
                return {Data = snapshot, Session = nextSession}
            end)
        end)
        if ok and result then success = true; p.SavedAt = os.time(); break end
        if ok and not result then break end -- Lost lock; do not retry a stale writer.
        if attempt < 3 then task.wait(attempt) end
    end
    p.Busy = false
    if not success then
        warn("[Wandbound] Save unavailable for user", player.UserId)
        if player.Parent then self.S.NetworkService:Notice(player, "Saving is temporarily unavailable. Please stay connected.") end
    end
    return success
end
function D:Release(player)
    local p = self.Profiles[player]; if not p or p.Releasing then return end
    p.Releasing = true; p.Closing = true
    self:Save(player, true)
    self.Profiles[player] = nil
end
function D:Start()
    Players.PlayerAdded:Connect(function(player) self:Load(player) end)
    Players.PlayerRemoving:Connect(function(player) self:Release(player) end)
    for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() self:Load(player) end) end
    task.spawn(function()
        while not self.Closing do
            task.wait(Config.SaveInterval)
            for player, p in pairs(self.Profiles) do
                if not p.Closing then task.spawn(function() self:Save(player, false) end) end
            end
        end
    end)
    task.spawn(function()
        while not self.Closing do
            task.wait(5)
            for player,p in pairs(self.Profiles) do
                if not self.Ephemeral and not p.Closing and os.time()-p.SavedAt > Config.LockLifetime-30 then
                    p.Closing = true
                    player:Kick("Saving has been unavailable too long. Rejoin shortly to protect your saved progress.")
                end
            end
        end
    end)
    game:BindToClose(function()
        self.Closing = true
        local pending = 0
        for player in pairs(self.Profiles) do
            pending = pending + 1
            task.spawn(function() self:Release(player); pending = pending-1 end)
        end
        local untilTime = os.clock() + 25
        while pending > 0 and os.clock() < untilTime do task.wait(0.1) end
    end)
end
return D
]]></ProtectedString>
					<string name="ScriptGuid">{E50C26AD-4D7B-49D9-A624-608FC9A2DC88}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PlayerDataService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000076a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000398">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local F = require(RS.Shared.Formulas)
local Spells = require(RS.Shared.SpellData)
local Quests = require(RS.Shared.QuestData)
local Skills = require(RS.Shared.SkillData)
local P = {}
function P:Init(services) self.S = services; self.HouseTotals = {}; for house in pairs(Config.Houses) do self.HouseTotals[house] = 0 end end
function P:Refresh(player)
    local d = self.S.PlayerDataService:Get(player); if not d then return end
    if player:FindFirstChild("leaderstats") then
        for _, v in ipairs(player.leaderstats:GetChildren()) do v.Value = d[v.Name] end
    end
    player:SetAttribute("House", d.House)
    player:SetAttribute("Level", d.Level)
    self.S.CombatService:HouseTrim(player)
    if d.SealDefeated and d.Level >= 15 then self:Learn(player, "Tonitra", true) end
    if d.BossDefeated and d.Level >= 20 then self:Learn(player, "Murallis", true) end
    self.S.NetworkService:Sync(player)
end
function P:Learn(player, id, quiet)
    local d = self.S.PlayerDataService:Get(player); local sp = Spells[id]
    if not d or not sp or not sp.Implemented or d.Level < sp.UnlockLevel or d.Spells[id] then return false end
    d.Spells[id] = {Mastery = 1, Hits = 0}
    local assigned=false
    for _,value in pairs(d.Loadout) do if value==id then assigned=true end end
    if id ~= "Scintara" and id ~= "Aegara" and not assigned then
        for i = 1,4 do local key = "Slot"..i; if d.Loadout[key] == "" then d.Loadout[key] = id; break end end
    end
    if not quiet then self.S.NetworkService:Notice(player, "Learned " .. sp.DisplayName .. " · " .. id) end
    self.S.NetworkService:Sync(player)
    return true
end
function P:Award(player, xp, gilders)
    local d = self.S.PlayerDataService:Get(player); if not d then return end
    d.XP = d.XP + xp; d.Gilders = d.Gilders + gilders
    local levelled = false
    while d.Level < Config.LevelCap and d.XP >= F.XP(d.Level) do
        d.XP = d.XP - F.XP(d.Level); d.Level = d.Level+1
        d.Attributes.Unspent = d.Attributes.Unspent+2; levelled = true
    end
    if d.Level == Config.LevelCap then d.XP = math.min(d.XP, F.XP(d.Level)) end
    if levelled then
        self.S.NetworkService:Notice(player, "Level " .. d.Level .. "! Spend attribute points in your journal and skill points under Skills.")
        self.S.CombatService:UpdateStats(player, true)
    end
    self:Refresh(player)
end
function P:HousePoints(player, amount)
    local d = self.S.PlayerDataService:Get(player); if not d or d.House == "" then return end
    d.HousePoints = d.HousePoints + amount
    self.HouseTotals[d.House] = self.HouseTotals[d.House] + amount
    self:Refresh(player)
end
function P:Event(player, kind, target)
    local d = self.S.PlayerDataService:Get(player); if not d then return end
    local q = Quests[d.Quest]
    if q and q.Kind == kind and (not q.Target or q.Target == target) then
        d.QuestProgress = d.QuestProgress+1
        if d.QuestProgress >= q.Need then
            d.QuestDone[q.Id] = true; d.Quest = d.Quest+1; d.QuestProgress = 0
            self.S.NetworkService:Notice(player, "Quest complete: " .. q.Title .. "  +" .. q.XP .. " XP")
            self:Award(player, q.XP, q.Gold)
            if q.Wand and not d.WandRewards[q.Wand] then
                d.WandRewards[q.Wand] = true
                self.S.WandService:GrantNamed(player, q.Wand, "Quest reward: %s. Equip it from your bag.")
            end
        end
    end
    if kind == "Kill" then
        local day = math.floor(os.time()/86400)
        if d.Daily.Day ~= day then d.Daily = {Day = day, Kills = 0, Claimed = false} end
        d.Daily.Kills = math.min(15, d.Daily.Kills+1)
        if d.Daily.Kills == 15 and not d.Daily.Claimed then
            d.Daily.Claimed = true; self:Award(player, 600, 120); self:HousePoints(player, 10)
            self.S.NetworkService:Notice(player, "Daily complete · 15 woodland foes defeated")
        end
    end
    self:Refresh(player)
end
function P:Hit(player, id)
    local d = self.S.PlayerDataService:Get(player); local s = d and d.Spells[id]; if not s then return end
    s.Hits = s.Hits+1; local m = F.Mastery(s.Hits)
    if m > s.Mastery then s.Mastery = m; self.S.NetworkService:Notice(player, id.." reached Mastery "..m); self:Refresh(player) end
end
function P:Talent(player, id)
    local d = self.S.PlayerDataService:Get(player)
    if not d or type(id) ~= "string" or self.S.DuelService:IsBusy(player) then return false end
    local ok, reason = Skills.CanLearn(d, id)
    if not ok then self.S.NetworkService:Notice(player, reason); return false end
    d.Talents[id] = (d.Talents[id] or 0) + 1
    local t = Skills.Talents[id]
    self.S.NetworkService:Notice(player, t.Name .. " · rank " .. d.Talents[id] .. " / " .. t.MaxRank)
    self.S.CombatService:UpdateStats(player, false); self:Refresh(player)
    return true
end
function P:Combo(player, combo)
    local d = self.S.PlayerDataService:Get(player); if not d or d.Combos[combo] then return end
    d.Combos[combo] = true; self.S.NetworkService:Notice(player, "Combo discovered: " .. combo); self:Refresh(player)
end
function P:Start()
    self.S.NetworkService.Handlers.Loadout = function(player, slot, id)
        local d = self.S.PlayerDataService:Get(player)
        if not d or type(slot) ~= "string" or type(id) ~= "string" or not d.Spells[id] or not Spells[id] or not Spells[id].Implemented then return end
        if slot ~= "Ward" and not slot:match("^Slot[1-4]$") then return end
        if slot == "Ward" and Spells[id].School ~= "Ward" then return end
        d.Loadout[slot] = id; self:Refresh(player)
        self.S.NetworkService:Notice(player,id.." assigned to "..slot)
    end
    self.S.NetworkService.Handlers.Attribute = function(player, name)
        local d = self.S.PlayerDataService:Get(player)
        if not d or not ({Power=true, Focus=true, Vitality=true, Agility=true})[name] or d.Attributes.Unspent < 1 then return end
        d.Attributes.Unspent = d.Attributes.Unspent-1; d.Attributes[name] = d.Attributes[name]+1
        self.S.CombatService:UpdateStats(player, false); self:Refresh(player)
    end
    self.S.NetworkService.Handlers.Talent = function(player, id) self:Talent(player, id) end
    self.S.NetworkService.Handlers.Setting = function(player, key, value)
        local d = self.S.PlayerDataService:Get(player)
        if not d or (key ~= "SpokenCasting" and key ~= "ReducedEffects") or type(value) ~= "boolean" then return end
        d.Settings[key] = value; self:Refresh(player)
    end
end
return P
]]></ProtectedString>
					<string name="ScriptGuid">{0F189CC7-2531-4C66-91E2-FAD2EB710FE7}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ProgressionService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000076b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000399">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Chat=game:GetService("TextChatService")
local Spells=require(RS.Shared.SpellData)
local F=require(RS.Shared.Formulas)
local Wands=require(RS.Shared.WandData)
local S={}
local function vector(v)
    return typeof(v)=="Vector3" and F.Finite(v.X) and F.Finite(v.Y) and F.Finite(v.Z)
end
function S:Init(services) self.S=services; self.Projectiles={}; self.Domes={}; self.Aims={}; self.SeenMessages={} end
function S:Reject(player,id,reason)
    if player.Parent then self.S.NetworkService.CastReply:FireClient(player,id,false,reason) end
end
function S:Params(ignore)
    local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude; p.FilterDescendantsInstances=ignore; return p
end
-- Units and characters never block sight lines or monster steering; only world geometry does.
function S:WorldIgnore()
    local list={self.S.WorldService.Runtime,workspace.Markers}
    for _,player in ipairs(Players:GetPlayers()) do if player.Character then list[#list+1]=player.Character end end
    return list
end
function S:Visible(from, target, ignore)
    local delta=target.Root.Position-from
    if delta.Magnitude<0.01 then return true end
    local hit=workspace:Raycast(from,delta,self:Params(ignore or {}))
    return not hit or hit.Instance:IsDescendantOf(target.Model)
end
-- Bolts and beams pass through units the caster cannot affect: allies outside a duel,
-- other students' lesson targets and defeated monsters.
function S:Trace(player,origin,direction,radius,params)
    local limit=1; for _ in pairs(self.S.CombatService.Targets) do limit=limit+1 end
    for _=1,limit do
        local hit
        if radius then hit=workspace:Spherecast(origin,radius,direction,params) else hit=workspace:Raycast(origin,direction,params) end
        local target=hit and self.S.CombatService:Resolve(hit.Instance)
        if not target or self.S.CombatService:CanDamage(player,target) then return hit end
        local ignore=params.FilterDescendantsInstances; ignore[#ignore+1]=target.Model; params.FilterDescendantsInstances=ignore
    end
end
function S:Impact(player,target,spell,spoken,scale,position)
    local C=self.S.CombatService
    if not C:CanDamage(player,target) then return end
    if player and self.S.DuelService:IsCounting(player) then return end
    if spell.Type=="Projectile" and C:Has(target,"Speculo") and target.Player and player then
        target.Statuses.Speculo=nil
        local caster=C.States[player]
        if caster then self:Projectile(target.Player,spell,target.Root.Position+Vector3.new(0,1,0),(caster.Root.Position-target.Root.Position).Unit,spoken,true) end
        return
    end
    local data=self.S.PlayerDataService:Get(player); if not data then return end
    local amount=F.Power(spell.Damage,data,spell,spoken)*(scale or 1)
    local combo
    if spell.Element=="Lightning" and C:Has(target,"Wet") then amount=amount*1.3; combo="Conduct" end
    if spell.Id=="Tonitra" and C:Has(target,"Chilled") then amount=amount*1.5; combo="Shatter"; C:Status(target,"Stunned",0.5,player) end
    if spell.School=="Hex" and C:Has(target,"Airborne") then amount=amount*1.25; combo="Juggle" end
    if spell.Id=="Ruptara" and C:Has(target,"Rooted") then amount=amount*1.2; combo="Anchored" end
    if spell.Element=="Fire" and target.MonsterId=="RotbarkSentinel" then amount=amount*1.5 end
    if not C:Damage(player,target,amount,spell) then return end
    if combo then self.S.ProgressionService:Combo(player,combo) end
    if spell.Id=="Scintara" and target.MonsterId and Wands.Signature(data)=="Static" then self:Static(player,target,amount) end
    if target.Humanoid.Health<=0 or target.Dummy then return end
    if spell.Status then C:Status(target,spell.Status,F.Duration(spell,data),player,spell.Dps and F.Power(spell.Dps,data,spell,spoken) or 0) end
    if spell.Id=="Ruptara" and not C:Has(target,"Rooted") and target.Rank~="Boss" then self:Displace(target,position,-8) end
    if spell.Id=="Tractum" and target.Rank~="Boss" then
        local caster=C.States[player]; if caster then self:Displace(target,caster.Root.Position,15) end
    end
end
-- Stormfork: every 4th Spark Bolt hit on a monster arcs once to the nearest other monster within 12 studs, for half the hit.
-- The arc is damage over time to CombatService, so it cannot crit or add Mastery.
function S:Static(player,target,amount)
    local C=self.S.CombatService; local s=C.States[player]; if not s then return end
    s.StaticHits=(s.StaticHits or 0)+1
    if s.StaticHits<4 then return end
    s.StaticHits=0
    local nextTarget,best=nil,12; local ignore=self:WorldIgnore()
    for _,candidate in pairs(C.Targets) do
        local d=(candidate.Root.Position-target.Root.Position).Magnitude
        if candidate~=target and candidate.MonsterId and C:CanDamage(player,candidate) and d<best
            and self:Visible(target.Root.Position,candidate,ignore) then best=d; nextTarget=candidate end
    end
    if not nextTarget then return end
    self.S.NetworkService.FX:FireAllClients("Beam",target.Root.Position,nextTarget.Root.Position,"Lightning")
    C:Damage(player,nextTarget,amount*0.5,Spells.Scintara,true)
end
function S:Displace(target,origin,distance)
    local delta=(origin-target.Root.Position)*Vector3.new(1,0,1)
    if delta.Magnitude<0.1 then return end
    local displacement=delta.Unit*math.min(math.abs(distance),delta.Magnitude)*(distance<0 and -1 or 1)
    local hit=workspace:Blockcast(target.Root.CFrame,Vector3.new(2,3,2),displacement,self:Params({target.Model}))
    if hit then displacement=displacement.Unit*math.max(0,hit.Distance-1) end
    local pos=target.Root.Position+displacement
    if target.Player then self.S.WorldService:Teleport(target.Player,pos) else target.Model:PivotTo(CFrame.new(pos)) end
end
function S:Blast(player,spell,spoken,position)
    local burning=false
    for _,target in pairs(self.S.CombatService.Targets) do
        if self.S.CombatService:CanDamage(player,target) and (target.Root.Position-position).Magnitude<=spell.Blast
            and self.S.CombatService:Has(target,"Burn") then burning=true end
    end
    local ignore=self:WorldIgnore()
    for _,target in pairs(self.S.CombatService.Targets) do
        if self.S.CombatService:CanDamage(player,target) and (target.Root.Position-position).Magnitude<=spell.Blast
            and self:Visible(position+Vector3.new(0,1,0),target,ignore) then
            self:Impact(player,target,spell,spoken,1,position)
            if burning and not target.Dummy then self.S.CombatService:Status(target,"Burn",3,player,4); self.S.ProgressionService:Combo(player,"Combust") end
        end
    end
    self.S.NetworkService.FX:FireAllClients("Blast",position,spell.Id,spell.Blast)
end
function S:Projectile(player,spell,origin,direction,spoken,reflected)
    local state=self.S.CombatService.States[player]; if not state then return end
    local params=self:Params({state.Model,workspace.Markers})
    local p={Player=player,Spell=spell,Pos=origin,Dir=direction,Distance=0,Spoken=spoken,Params=params,Reflected=reflected,State=state}
    self.Projectiles[#self.Projectiles+1]=p
    self.S.NetworkService.FX:FireAllClients("Projectile",origin,direction,spell.Id,spell.Speed,spell.Range)
end
function S:HitProjectile(p,part,position)
    if p.Spell.Blast then self:Blast(p.Player,p.Spell,p.Spoken,position)
    else
        local target=self.S.CombatService:Resolve(part)
        if target then
            if p.Reflected and self.S.CombatService:Has(target,"Speculo") then target.Statuses.Speculo=nil
            else self:Impact(p.Player,target,p.Spell,p.Spoken,1,position) end
        end
    end
    self.S.NetworkService.FX:FireAllClients("Impact",position,p.Spell.Id)
end
function S:Step(dt)
    local now=os.clock()
    for i=#self.Domes,1,-1 do if now>self.Domes[i].Until or not self.Domes[i].Player.Parent then table.remove(self.Domes,i) end end
    for i=#self.Projectiles,1,-1 do
        local p=self.Projectiles[i]
        if self.S.CombatService.States[p.Player]~=p.State or p.State.Humanoid.Health<=0 or not self.S.PlayerDataService:Get(p.Player) then table.remove(self.Projectiles,i)
        else
            local step=math.min(p.Spell.Speed*dt,p.Spell.Range-p.Distance)
            local nextPos=p.Pos+p.Dir*step; local blocked=false
            for _,d in ipairs(self.Domes) do
                if d.Player~=p.Player and self.S.DuelService:CanDamage(p.Player,d.Player) then
                    local segment=nextPos-p.Pos
                    local t=math.clamp((d.Pos-p.Pos):Dot(segment)/math.max(0.001,segment:Dot(segment)),0,1)
                    if (p.Pos+segment*t-d.Pos).Magnitude<10 then blocked=true; break end
                end
            end
            local hit=not blocked and self:Trace(p.Player,p.Pos,p.Dir*math.max(step,0.001),p.Spell.Radius,p.Params) or nil
            -- Spherecast excludes initial overlaps. Check the initial volume too.
            if not blocked and p.Distance==0 and not hit then
                local overlap=OverlapParams.new(); overlap.FilterType=Enum.RaycastFilterType.Exclude; overlap.FilterDescendantsInstances=p.Params.FilterDescendantsInstances
                for _,part in ipairs(workspace:GetPartBoundsInRadius(p.Pos,p.Spell.Radius,overlap)) do
                    local target=self.S.CombatService:Resolve(part)
                    if target and self.S.CombatService:CanDamage(p.Player,target) then hit={Instance=part,Position=p.Pos}; break end
                end
            end
            if hit then self:HitProjectile(p,hit.Instance,hit.Position); table.remove(self.Projectiles,i)
            elseif blocked or p.Distance+step>=p.Spell.Range then table.remove(self.Projectiles,i)
            else p.Pos=nextPos; p.Distance=p.Distance+step end
        end
    end
end
function S:Execute(player,spell,aim,spoken)
    local C=self.S.CombatService; local s=C.States[player]; local data=self.S.PlayerDataService:Get(player)
    if not data or not C:CanAct(s) or C:Has(s,"Silenced") then return end
    local origin=s.Root.Position+Vector3.new(0,1.2,0)
    local delta=aim-origin; local dir=delta.Magnitude>0.01 and delta.Unit or s.Root.CFrame.LookVector
    if spell.Type=="Projectile" then self:Projectile(player,spell,origin,dir,spoken); return end
    if spell.Id=="Aegara" then
        s.Shield=F.Power(40,data,spell,spoken); s.ShieldUntil=os.clock()+2
        self.S.NetworkService.FX:FireAllClients("Ward",s.Model,2)
    elseif spell.Id=="Speculo" or spell.Id=="Durassa" or spell.Id=="Velocis" then
        C:Status(s,spell.Id,F.Duration(spell,data),player)
        if spell.Id=="Speculo" then self.S.NetworkService.FX:FireAllClients("Ward",s.Model,0.6) end
    elseif spell.Id=="Glimmora" then
        s.Light=not s.Light; local old=s.Root:FindFirstChild("Glimmora"); if old then old:Destroy() end
        if s.Light then local light=Instance.new("PointLight"); light.Name="Glimmora"; light.Range=24; light.Brightness=2; light.Color=Color3.fromRGB(199,180,255); light.Parent=s.Root end
    elseif spell.Id=="Murallis" then
        self.Domes[#self.Domes+1]={Player=player,Pos=s.Root.Position,Until=os.clock()+4}
        self.S.NetworkService.FX:FireAllClients("Dome",s.Root.Position,4)
    elseif spell.Id=="Vitara" or spell.Id=="Purgo" then
        local hit=workspace:Raycast(origin,dir*spell.Range,self:Params({s.Model,workspace.Markers}))
        local target=hit and C:Resolve(hit.Instance) or s
        if not target or not target.Player or (target.Player~=player and (self.S.DuelService:IsBusy(player) or self.S.DuelService:IsBusy(target.Player))) then target=s end
        if spell.Id=="Vitara" then
            -- Hearthroot's Sapflow: a Mend that restores health refunds 6 mana.
            if C:Heal(player,target,F.Power(25,data,spell,spoken))>0 and Wands.Signature(data)=="Sapflow" then
                s.Mana=math.min(s.MaxMana,s.Mana+6)
                if target~=s then self.S.NetworkService.FX:FireAllClients("Beam",target.Root.Position,s.Root.Position,"Restoration") end
                self.S.NetworkService.FX:FireAllClients("Status",s.Root.Position,"Restoration")
            end
        else for _,name in ipairs({"Burn","Chilled","Silenced","Rooted","Asleep"}) do target.Statuses[name]=nil end; self.S.NetworkService.FX:FireAllClients("Heal",target.Root.Position,0) end
    elseif spell.Id=="Resero" then
        local hit=workspace:Raycast(origin,dir*35,self:Params({s.Model,workspace.Markers}))
        if hit then self.S.InteractionService:Unseal(player,hit.Instance) end
    elseif spell.Type=="Beam" then
        local hit=self:Trace(player,origin,dir*spell.Range,nil,self:Params({s.Model,workspace.Markers}))
        local endpoint=hit and hit.Position or origin+dir*spell.Range
        self.S.NetworkService.FX:FireAllClients("Beam",origin,endpoint,spell.Id)
        local target=hit and C:Resolve(hit.Instance)
        if target then
            self:Impact(player,target,spell,spoken,1,endpoint)
            if spell.Id=="Tonitra" then
                local seen={[target]=true}; local last=target; local ignore=self:WorldIgnore()
                for jump=1,2 do
                    local nextTarget,best=nil,25
                    for _,candidate in pairs(C.Targets) do
                        local d=(candidate.Root.Position-last.Root.Position).Magnitude
                        if not seen[candidate] and C:CanDamage(player,candidate) and d<best
                            and self:Visible(last.Root.Position,candidate,ignore) then best=d; nextTarget=candidate end
                    end
                    if not nextTarget then break end
                    self.S.NetworkService.FX:FireAllClients("Beam",last.Root.Position,nextTarget.Root.Position,spell.Id)
                    self:Impact(player,nextTarget,spell,spoken,0.75^jump,nextTarget.Root.Position)
                    seen[nextTarget]=true; last=nextTarget
                end
            end
        end
    end
end
function S:Cast(player,id,aim,spoken)
    if type(id)~="string" or #id>32 or not vector(aim) then return end
    local spell=Spells[id]; local data=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
    if not spell or not spell.Implemented or not data or not data.HasWand or not data.Spells[id] then return self:Reject(player,id,"Learn this spell first.") end
    local C=self.S.CombatService
    if not C:CanAct(s) or C:Has(s,"Silenced") or self.S.DuelService:IsCounting(player) then return self:Reject(player,id,"You cannot cast right now.") end
    if (aim-s.Root.Position).Magnitude>1000 then return end
    if not spoken then
        local equipped=id=="Scintara"
        for _,value in pairs(data.Loadout) do if value==id then equipped=true end end
        if not equipped then return end
    elseif not data.Settings.SpokenCasting then return end
    local now=os.clock()
    if now<s.BusyUntil or now<(s.Cooldowns[id] or 0) then return self:Reject(player,id,"Cooling down") end
    local cost=F.ManaCost(spell,data); local cooldown=F.Cooldown(spell,data)
    if s.Mana<cost then return self:Reject(player,id,"Not enough mana") end
    local castTime=spell.CastTime+(spoken and 0.3 or 0)
    s.Mana=s.Mana-cost; s.Cooldowns[id]=now+cooldown
    s.BusyUntil=now+castTime; s.InvulnerableUntil=0
    self.S.NetworkService.CastReply:FireClient(player,id,true,cooldown)
    task.delay(castTime,function()
        if C.States[player]==s and player.Parent then self:Execute(player,spell,aim,spoken) end
    end)
end
function S:Spoken(player,text)
    if type(text)~="string" or #text>64 or not self.S.NetworkService:Allow(player,"Spoken",3,5) then return end
    text=text:lower():gsub("^%s+",""):gsub("%s+$","")
    local state=self.S.CombatService.States[player]; if not state then return end
    local update=self.Aims[player]
    local aim=update and os.clock()-update.Time<1 and update.Position or state.Root.Position+state.Root.CFrame.LookVector*120
    for id in pairs(Spells) do if text==id:lower() then self:Cast(player,id,aim,true); break end end
end
function S:Start()
    self.S.NetworkService:Bind("Cast",10,12,function(player,id,aim) self:Cast(player,id,aim,false) end)
    self.S.NetworkService:Bind("Aim",12,15,function(player,aim)
        local root=self.S.WorldService:Root(player)
        if root and vector(aim) and (aim-root.Position).Magnitude<=500 then self.Aims[player]={Position=aim,Time=os.clock()} end
    end)
    RunService.Heartbeat:Connect(function(dt) self:Step(math.min(dt,0.15)) end)
    local command=Instance.new("TextChatCommand"); command.Name="WandboundCast"; command.PrimaryAlias="/cast"; command.Parent=Chat
    command.Triggered:Connect(function(source,text)
        local player=Players:GetPlayerByUserId(source.UserId)
        if player then self:Spoken(player,text:gsub("^%S+%s*","")) end
    end)
    -- Delivery callbacks run once per recipient. Deduplicate by MessageId before casting.
    task.spawn(function()
        local channels=Chat:WaitForChild("TextChannels",15); local general=channels and channels:WaitForChild("RBXGeneral",15)
        if not general then return end
        general.ShouldDeliverCallback=function(message)
            local id=message.MessageId
            if message.TextSource and id~="" and not self.SeenMessages[id] then
                self.SeenMessages[id]=os.clock()
                local player=Players:GetPlayerByUserId(message.TextSource.UserId)
                if player then task.defer(function() self:Spoken(player,message.Text) end) end
            end
            return true
        end
    end)
    task.spawn(function() while true do task.wait(30); for id,t in pairs(self.SeenMessages) do if os.clock()-t>30 then self.SeenMessages[id]=nil end end end end)
    Players.PlayerRemoving:Connect(function(player) self.Aims[player]=nil end)
end
return S
]]></ProtectedString>
					<string name="ScriptGuid">{DEA9C4D1-BC38-420C-9D38-397A66E31185}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">SpellService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000076c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000039A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local W = {}
function W:Init(services)
    self.S = services; self.Markers = workspace:WaitForChild("Markers"); self.Movement = {}
    self.Runtime = Instance.new("Folder"); self.Runtime.Name = "Runtime"; self.Runtime.Parent = workspace
    self.Monsters = Instance.new("Folder"); self.Monsters.Name = "Monsters"; self.Monsters.Parent = self.Runtime
    self.Targets = Instance.new("Folder"); self.Targets.Name = "Targets"; self.Targets.Parent = self.Runtime
end
function W:Root(player)
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
function W:Zone(position)
    for _, z in ipairs(Config.Zones) do
        if math.abs(position.X-z.Center[1]) <= z.Size[1]/2 and math.abs(position.Z-z.Center[2]) <= z.Size[2]/2 then return z end
    end
    return {Id = "Grounds", Name = "Castle Grounds", Safe = true}
end
function W:Anchor(name) return self.Markers:FindFirstChild(name) end
function W:Near(player, anchor, range)
    local root = self:Root(player); local marker = type(anchor) == "string" and self:Anchor(anchor) or anchor
    local s = self.S.CombatService.States[player]
    return root and marker and s and s.Humanoid.Health > 0 and (root.Position-marker.Position).Magnitude <= (range or 15)
end
function W:Teleport(player, position)
    local root = self:Root(player); if not root then return end
    self.Movement[player] = {Pos = position, Time = os.clock(), Grace = os.clock()+2}
    player.Character:PivotTo(CFrame.new(position))
    root.AssemblyLinearVelocity = Vector3.zero
end
function W:Travel(player, destination)
    local d = self.S.PlayerDataService:Get(player); local pos = Config.Waystones[destination]
    local s = self.S.CombatService.States[player]
    if not d or not pos or not d.Waystones[destination] or not s then return end
    if self.S.DuelService:IsBusy(player) or os.clock()-s.LastCombat < 8 then return self.S.NetworkService:Notice(player, "Travel is unavailable during combat.") end
    local near = false
    for id in pairs(Config.Waystones) do if self:Near(player, "Waystone_"..id, 16) then near = true end end
    if not near then return self.S.NetworkService:Notice(player, "Stand beside a Waystone to travel.") end
    if d.Gilders < 25 then return self.S.NetworkService:Notice(player, "Waystone travel costs 25 Gilders.") end
    d.Gilders = d.Gilders-25; d.LastWaystone = destination
    self:Teleport(player, Vector3.new(pos[1],pos[2],pos[3])); self.S.ProgressionService:Refresh(player)
end
function W:Start()
    self.S.NetworkService.Handlers.Travel = function(player, id) if type(id) == "string" then self:Travel(player, id) end end
    Players.PlayerRemoving:Connect(function(player) self.Movement[player] = nil end)
    task.spawn(function()
        local start = os.clock()
        while true do
            task.wait(0.5)
            Lighting.ClockTime = (9 + (os.clock()-start)/Config.DayLength*24) % 24
            for _, player in ipairs(Players:GetPlayers()) do
                local root = self:Root(player); local state = self.S.CombatService.States[player]
                if root and state and state.Humanoid.Health > 0 then
                    local z = self:Zone(root.Position); player:SetAttribute("Zone", z.Id)
                    local now = os.clock(); local prev = self.Movement[player]
                    if prev and now > (prev.Grace or 0) then
                        local delta = Vector3.new(root.Position.X-prev.Pos.X,0,root.Position.Z-prev.Pos.Z).Magnitude
                        local allowance = math.max(state.Humanoid.WalkSpeed, 24)*(now-prev.Time)+20
                        if delta > allowance or math.abs(root.Position.X) > 340 or math.abs(root.Position.Z) > 290 then
                            self:Teleport(player, prev.Pos); root = self:Root(player)
                        end
                    end
                    if root.Position.Y < -20 then self:Teleport(player, Vector3.new(90,5,164)) end
                    local grace = self.Movement[player] and self.Movement[player].Grace or 0
                    self.Movement[player] = {Pos = root.Position, Time = now, Grace = grace}
                end
            end
        end
    end)
end
return W
]]></ProtectedString>
					<string name="ScriptGuid">{DE3BCD93-D08A-4230-B0F5-FFEC05555015}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WorldService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000076d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX83BD2E390C7B4F9A970C1CF503A06AB6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Wands=require(RS.Shared.WandData)
local WandModel=require(RS.Shared.WandModel)
local Quests=require(RS.Shared.QuestData)
local F=require(RS.Shared.Formulas)
local W={}
function W:Init(services) self.S=services end
-- Names plus a case revision protect selections even when two wands look identical.
function W:Valid(d,index,name,revision)
    return (revision==nil or revision==(d.WandRevision or 0)) and F.Finite(index) and index%1==0 and index>=1 and index<=#d.Wands and (name==nil or Wands.Name(d.Wands[index])==name)
end
-- Replaces the wand model in the character's hand with the equipped wand.
function W:Attach(player)
    local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
    if not d or not s then return end
    local old=s.Model:FindFirstChild("RavenmoorWand"); if old then old:Destroy() end
    local wand=d.Wands[d.EquippedWand]; if not d.HasWand or not wand then return end
    local hand=s.Model:FindFirstChild("RightHand") or s.Model:FindFirstChild("Right Arm"); if not hand then return end
    local model=WandModel.Build(wand,hand.CFrame*CFrame.new(0,-0.2,0),false); model.Name="RavenmoorWand"
    local weld=Instance.new("WeldConstraint"); weld.Part0=hand; weld.Part1=model.PrimaryPart; weld.Parent=model.PrimaryPart
    model.Parent=s.Model
end
function W:Use(player,index)
    local d=self.S.PlayerDataService:Get(player)
    d.WandRevision=(d.WandRevision or 0)+1
    d.EquippedWand=index; d.Wand=Wands.Label(d.Wands[index])
    local s=self.S.CombatService.States[player]; if s then s.StaticHits=0 end
    self:Attach(player); self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
end
-- Adds a wand to the case, equipping it when it is the first. Returns false when the case is full.
function W:Grant(player,wand)
    local d=self.S.PlayerDataService:Get(player)
    if not d or #d.Wands>=Wands.Capacity then return false end
    d.WandRevision=(d.WandRevision or 0)+1
    d.Wands[#d.Wands+1]=wand
    if d.EquippedWand==0 then self:Use(player,#d.Wands) else self.S.ProgressionService:Refresh(player) end
    return true
end
function W:Reward(player,rarity)
    local wand=Wands.Roll(rarity)
    if self:Grant(player,wand) then self.S.NetworkService:Notice(player,"A wand was left behind: "..Wands.Name(wand).."!")
    else self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag to collect more.") end
end
-- Gives a named wand; while the case is full, Oakhart holds it instead. `message` formats the wand's name.
function W:GrantNamed(player,id,message)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not Wands.Named[id] then return false end
    local wand=Wands.Make(id)
    if self:Grant(player,wand) then self.S.NetworkService:Notice(player,message:format(Wands.Name(wand))); return true end
    d.WandsHeld[#d.WandsHeld+1]=id
    self.S.NetworkService:Notice(player,"Your wand case is full. Oakhart will keep your "..Wands.Named[id].Title.." until you make room.")
    return false
end
-- At Oakhart's: queues quest wands earned before they existed, then hands over held wands while the case has room.
function W:Deliver(player)
    local d=self.S.PlayerDataService:Get(player); if not d then return end
    for _,q in ipairs(Quests) do
        if q.Wand and d.QuestDone[q.Id] and not d.WandRewards[q.Wand] then d.WandRewards[q.Wand]=true; d.WandsHeld[#d.WandsHeld+1]=q.Wand end
    end
    while #d.WandsHeld>0 and #d.Wands<Wands.Capacity do
        local wand=Wands.Make(table.remove(d.WandsHeld,1))
        self:Grant(player,wand); self.S.NetworkService:Notice(player,"Oakhart hands you your "..Wands.Name(wand)..". Equip it from your bag.")
    end
end
function W:Commission(player,id)
    local d=self.S.PlayerDataService:Get(player); local named=Wands.Named[id]; local recipe=named and named.Recipe
    if not d or not recipe or not d.HasWand or not self.S.WorldService:Near(player,"Oakhart",15) or self.S.DuelService:IsBusy(player) then return end
    if #d.Wands>=Wands.Capacity then return self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag first.") end
    if d.Level<recipe.Level then return self.S.NetworkService:Notice(player,named.Title.." is commissioned from level "..recipe.Level..".") end
    for item,need in pairs(recipe.Items) do
        if (d.Inventory[item] or 0)<need then return self.S.NetworkService:Notice(player,named.Title.." needs "..item.." ×"..need..".") end
    end
    if d.Gilders<recipe.Gilders then return self.S.NetworkService:Notice(player,named.Title.." costs "..recipe.Gilders.." Gilders.") end
    for item,need in pairs(recipe.Items) do d.Inventory[item]=d.Inventory[item]-need end
    d.Gilders=d.Gilders-recipe.Gilders
    local wand=Wands.Make(id); self:Grant(player,wand)
    self.S.NetworkService:Notice(player,"Oakhart hands you a "..Wands.Name(wand)..". Equip it from your bag.")
end
function W:Equip(player,index,name,revision)
    local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
    if not d or not s or not self:Valid(d,index,name,revision) or index==d.EquippedWand then return end
    if self.S.DuelService:IsBusy(player) or os.clock()-s.LastCombat<5 then return self.S.NetworkService:Notice(player,"Wands can't be swapped during combat.") end
    self:Use(player,index); self.S.NetworkService:Notice(player,"Equipped your "..Wands.Name(d.Wands[index]))
end
function W:Discard(player,index,name,revision)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not self:Valid(d,index,name,revision) or index==d.EquippedWand then return end
    d.WandRevision=(d.WandRevision or 0)+1
    local wand=table.remove(d.Wands,index)
    if d.EquippedWand>index then d.EquippedWand=d.EquippedWand-1 end
    self.S.NetworkService:Notice(player,"Discarded your "..Wands.Name(wand)); self.S.ProgressionService:Refresh(player)
end
function W:Buy(player)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not d.HasWand or not self.S.WorldService:Near(player,"Oakhart",15) or self.S.DuelService:IsBusy(player) then return end
    if #d.Wands>=Wands.Capacity then return self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag first.") end
    if d.Gilders<Wands.Price then return self.S.NetworkService:Notice(player,"A commissioned wand costs "..Wands.Price.." Gilders.") end
    d.Gilders=d.Gilders-Wands.Price
    local wand=Wands.Roll(); self:Grant(player,wand)
    self.S.NetworkService:Notice(player,"Oakhart hands you a "..Wands.Name(wand)..". Equip it from your bag.")
end
function W:Start()
    local handlers=self.S.NetworkService.Handlers
    handlers.EquipWand=function(player,index,selection)
        if type(selection)=="table" and type(selection.Name)=="string" and F.Finite(selection.Revision) then self:Equip(player,index,selection.Name,selection.Revision) end
    end
    handlers.DiscardWand=function(player,index,selection)
        if type(selection)=="table" and type(selection.Name)=="string" and F.Finite(selection.Revision) then self:Discard(player,index,selection.Name,selection.Revision) end
    end
    handlers.BuyWand=function(player) self:Buy(player) end
    handlers.CommissionWand=function(player,id) if type(id)=="string" then self:Commission(player,id) end end
end
return W
]]></ProtectedString>
