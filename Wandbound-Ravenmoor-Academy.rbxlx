			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">03d2e6901b9fab800aeb6390000003c2</UniqueId>
		</Properties>
		<Item class="Script" referent="RBX0000038F">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
Players.CharacterAutoLoads = false
local order = {"NetworkService", "PlayerDataService", "ProgressionService", "WorldService",
    "CombatService", "SpellService", "MonsterService", "ClassService", "DuelService", "WandService", "InteractionService", "FlightService", "AdminService"}
local services = {}
for _, name in ipairs(order) do services[name] = require(script.Parent.Services[name]) end
for _, name in ipairs(order) do services[name]:Init(services) end
for _, name in ipairs(order) do if name ~= "PlayerDataService" then services[name]:Start() end end
services.PlayerDataService:Start()
workspace:SetAttribute("WandboundReady", true)
print("[Wandbound] Ravenmoor Academy 0.1.0 ready")
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{FE85B0B2-286F-4BB1-A8D8-A22D72968FE7}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Main</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
