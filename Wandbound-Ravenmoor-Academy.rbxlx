			</Item>
			<Item class="ModuleScript" referent="RBX0000039A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local W = {}
function W:Init(services)
    self.S = services; self.Markers = workspace:WaitForChild("Markers"); self.Movement = {}
    self.Runtime = Instance.new("Folder"); self.Runtime.Name = "Runtime"; self.Runtime.Parent = workspace
    self.Monsters = Instance.new("Folder"); self.Monsters.Name = "Monsters"; self.Monsters.Parent = self.Runtime
    self.Targets = Instance.new("Folder"); self.Targets.Name = "Targets"; self.Targets.Parent = self.Runtime
end
function W:Root(player)
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
function W:Zone(position)
    for _, z in ipairs(Config.Zones) do
        if math.abs(position.X-z.Center[1]) <= z.Size[1]/2 and math.abs(position.Z-z.Center[2]) <= z.Size[2]/2 then return z end
    end
    return {Id = "Grounds", Name = "Castle Grounds", Safe = true}
end
function W:Anchor(name) return self.Markers:FindFirstChild(name) end
function W:Near(player, anchor, range)
    local root = self:Root(player); local marker = type(anchor) == "string" and self:Anchor(anchor) or anchor
    local s = self.S.CombatService.States[player]
    return root and marker and s and s.Humanoid.Health > 0 and (root.Position-marker.Position).Magnitude <= (range or 15)
end
function W:Teleport(player, position)
    local root = self:Root(player); if not root then return end
    self.Movement[player] = {Pos = position, Time = os.clock(), Grace = os.clock()+2}
    player.Character:PivotTo(CFrame.new(position))
    root.AssemblyLinearVelocity = Vector3.zero
end
function W:Travel(player, destination)
    local d = self.S.PlayerDataService:Get(player); local pos = Config.Waystones[destination]
    local s = self.S.CombatService.States[player]
    if not d or not pos or not d.Waystones[destination] or not s then return end
    if self.S.DuelService:IsBusy(player) or os.clock()-s.LastCombat < 8 then return self.S.NetworkService:Notice(player, "Travel is unavailable during combat.") end
    local near = false
    for id in pairs(Config.Waystones) do if self:Near(player, "Waystone_"..id, 16) then near = true end end
    if not near then return self.S.NetworkService:Notice(player, "Stand beside a Waystone to travel.") end
    if d.Gilders < 25 then return self.S.NetworkService:Notice(player, "Waystone travel costs 25 Gilders.") end
    d.Gilders = d.Gilders-25; d.LastWaystone = destination
    self:Teleport(player, Vector3.new(pos[1],pos[2],pos[3])); self.S.ProgressionService:Refresh(player)
end
-- Night lights (Config.NightLights: lit windows and lanterns across the map, and in the imported village in
-- Workspace.Scenery) are plain glass by day. After dark they glow, and the lights inside them switch on.
function W:SetNightLights(night)
    if night == self.Night then return end
    self.Night = night
    for _, glass in ipairs(self.NightLights) do
        glass.Material = night and Enum.Material.Neon or Enum.Material.Glass
        for _, light in ipairs(glass:GetChildren()) do if light:IsA("Light") then light.Enabled = night end end
    end
end
function W:Start()
    self.S.NetworkService.Handlers.Travel = function(player, id) if type(id) == "string" then self:Travel(player, id) end end
    Players.PlayerRemoving:Connect(function(player) self.Movement[player] = nil end)
    self.NightLights = {}
    local names = {}
    for _, name in ipairs(Config.NightLights) do names[name] = true end
    for _, name in ipairs({"Map", "Scenery"}) do
        local root = workspace:FindFirstChild(name)
        if root then
            for _, item in ipairs(root:GetDescendants()) do
                if item:IsA("BasePart") and names[item.Name] then table.insert(self.NightLights, item) end
            end
        end
    end
    task.spawn(function()
        local start = os.clock()
        while true do
            task.wait(0.5)
            Lighting.ClockTime = (9 + (os.clock()-start)/Config.DayLength*24) % 24
            self:SetNightLights(Lighting.ClockTime >= 18.5 or Lighting.ClockTime < 6)
            for _, player in ipairs(Players:GetPlayers()) do
                local root = self:Root(player); local state = self.S.CombatService.States[player]
                if root and state and state.Humanoid.Health > 0 then
                    local z = self:Zone(root.Position); player:SetAttribute("Zone", z.Id)
                    local now = os.clock(); local prev = self.Movement[player]
                    if prev and now > (prev.Grace or 0) then
                        local delta = Vector3.new(root.Position.X-prev.Pos.X,0,root.Position.Z-prev.Pos.Z).Magnitude
                        -- A broom rider (FlightService) may cover ground at the broom's speed.
                        local allowance = math.max(state.Humanoid.WalkSpeed, 24, state.FlySpeed or 0)*(now-prev.Time)+20
                        local b, p = Config.WorldBounds, root.Position
                        if delta > allowance or p.X < b.MinX or p.X > b.MaxX or p.Z < b.MinZ or p.Z > b.MaxZ then
                            self:Teleport(player, prev.Pos); root = self:Root(player)
                        end
                    end
                    if root.Position.Y < -20 then self:Teleport(player, Vector3.new(90,5,164)) end
                    local grace = self.Movement[player] and self.Movement[player].Grace or 0
                    self.Movement[player] = {Pos = root.Position, Time = now, Grace = grace}
                end
            end
        end
    end)
end
return W
]]></ProtectedString>
					<string name="ScriptGuid">{DE3BCD93-D08A-4230-B0F5-FFEC05555015}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WorldService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000076d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX83BD2E390C7B4F9A970C1CF503A06AB6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Wands=require(RS.Shared.WandData)
local WandModel=require(RS.Shared.WandModel)
local Quests=require(RS.Shared.QuestData)
local F=require(RS.Shared.Formulas)
local W={}
function W:Init(services) self.S=services end
-- Names plus a case revision protect selections even when two wands look identical.
function W:Valid(d,index,name,revision)
    return (revision==nil or revision==(d.WandRevision or 0)) and F.Finite(index) and index%1==0 and index>=1 and index<=#d.Wands and (name==nil or Wands.Name(d.Wands[index])==name)
end
-- Replaces the wand model in the character's hand with the equipped wand.
function W:Attach(player)
    local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
    if not d or not s then return end
    local old=s.Model:FindFirstChild("RavenmoorWand"); if old then old:Destroy() end
    local wand=d.Wands[d.EquippedWand]; if not d.HasWand or not wand then return end
    local hand=s.Model:FindFirstChild("RightHand") or s.Model:FindFirstChild("Right Arm"); if not hand then return end
    local model=WandModel.Build(wand,hand.CFrame*CFrame.new(0,-0.2,0),false); model.Name="RavenmoorWand"
    local weld=Instance.new("WeldConstraint"); weld.Part0=hand; weld.Part1=model.PrimaryPart; weld.Parent=model.PrimaryPart
    model.Parent=s.Model
end
function W:Use(player,index)
    local d=self.S.PlayerDataService:Get(player)
    d.WandRevision=(d.WandRevision or 0)+1
    d.EquippedWand=index; d.Wand=Wands.Label(d.Wands[index])
    local s=self.S.CombatService.States[player]; if s then s.StaticHits=0 end
    self:Attach(player); self.S.CombatService:UpdateStats(player,false); self.S.ProgressionService:Refresh(player)
end
-- Adds a wand to the case, equipping it when it is the first. Returns false when the case is full.
function W:Grant(player,wand)
    local d=self.S.PlayerDataService:Get(player)
    if not d or #d.Wands>=Wands.Capacity then return false end
    d.WandRevision=(d.WandRevision or 0)+1
    d.Wands[#d.Wands+1]=wand
    if d.EquippedWand==0 then self:Use(player,#d.Wands) else self.S.ProgressionService:Refresh(player) end
    return true
end
function W:Reward(player,rarity)
    local wand=Wands.Roll(rarity)
    if self:Grant(player,wand) then self.S.NetworkService:Notice(player,"A wand was left behind: "..Wands.Name(wand).."!")
    else self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag to collect more.") end
end
-- Gives a named wand; while the case is full, Oakhart holds it instead. `message` formats the wand's name.
function W:GrantNamed(player,id,message)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not Wands.Named[id] then return false end
    local wand=Wands.Make(id)
    if self:Grant(player,wand) then self.S.NetworkService:Notice(player,message:format(Wands.Name(wand))); return true end
    d.WandsHeld[#d.WandsHeld+1]=id
    self.S.NetworkService:Notice(player,"Your wand case is full. Oakhart will keep your "..Wands.Named[id].Title.." until you make room.")
    return false
end
-- At Oakhart's: queues quest wands earned before they existed, then hands over held wands while the case has room.
function W:Deliver(player)
    local d=self.S.PlayerDataService:Get(player); if not d then return end
    for _,q in ipairs(Quests) do
        if q.Wand and d.QuestDone[q.Id] and not d.WandRewards[q.Wand] then d.WandRewards[q.Wand]=true; d.WandsHeld[#d.WandsHeld+1]=q.Wand end
    end
    while #d.WandsHeld>0 and #d.Wands<Wands.Capacity do
        local wand=Wands.Make(table.remove(d.WandsHeld,1))
        self:Grant(player,wand); self.S.NetworkService:Notice(player,"Oakhart hands you your "..Wands.Name(wand)..". Equip it from your bag.")
    end
end
function W:Commission(player,id)
    local d=self.S.PlayerDataService:Get(player); local named=Wands.Named[id]; local recipe=named and named.Recipe
    if not d or not recipe or not d.HasWand or not self.S.WorldService:Near(player,"Oakhart",15) or self.S.DuelService:IsBusy(player) then return end
    if #d.Wands>=Wands.Capacity then return self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag first.") end
    if d.Level<recipe.Level then return self.S.NetworkService:Notice(player,named.Title.." is commissioned from level "..recipe.Level..".") end
    for item,need in pairs(recipe.Items) do
        if (d.Inventory[item] or 0)<need then return self.S.NetworkService:Notice(player,named.Title.." needs "..item.." ×"..need..".") end
    end
    if d.Gilders<recipe.Gilders then return self.S.NetworkService:Notice(player,named.Title.." costs "..recipe.Gilders.." Gilders.") end
    for item,need in pairs(recipe.Items) do d.Inventory[item]=d.Inventory[item]-need end
    d.Gilders=d.Gilders-recipe.Gilders
    local wand=Wands.Make(id); self:Grant(player,wand)
    self.S.NetworkService:Notice(player,"Oakhart hands you a "..Wands.Name(wand)..". Equip it from your bag.")
end
function W:Equip(player,index,name,revision)
    local d=self.S.PlayerDataService:Get(player); local s=self.S.CombatService.States[player]
    if not d or not s or not self:Valid(d,index,name,revision) or index==d.EquippedWand then return end
    if self.S.DuelService:IsBusy(player) or os.clock()-s.LastCombat<5 then return self.S.NetworkService:Notice(player,"Wands can't be swapped during combat.") end
    self:Use(player,index); self.S.NetworkService:Notice(player,"Equipped your "..Wands.Name(d.Wands[index]))
end
function W:Discard(player,index,name,revision)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not self:Valid(d,index,name,revision) or index==d.EquippedWand then return end
    d.WandRevision=(d.WandRevision or 0)+1
    local wand=table.remove(d.Wands,index)
    if d.EquippedWand>index then d.EquippedWand=d.EquippedWand-1 end
    self.S.NetworkService:Notice(player,"Discarded your "..Wands.Name(wand)); self.S.ProgressionService:Refresh(player)
end
function W:Buy(player)
    local d=self.S.PlayerDataService:Get(player)
    if not d or not d.HasWand or not self.S.WorldService:Near(player,"Oakhart",15) or self.S.DuelService:IsBusy(player) then return end
    if #d.Wands>=Wands.Capacity then return self.S.NetworkService:Notice(player,"Your wand case is full. Discard a wand in your bag first.") end
    if d.Gilders<Wands.Price then return self.S.NetworkService:Notice(player,"A commissioned wand costs "..Wands.Price.." Gilders.") end
    d.Gilders=d.Gilders-Wands.Price
    local wand=Wands.Roll(); self:Grant(player,wand)
    self.S.NetworkService:Notice(player,"Oakhart hands you a "..Wands.Name(wand)..". Equip it from your bag.")
end
function W:Start()
    local handlers=self.S.NetworkService.Handlers
    handlers.EquipWand=function(player,index,selection)
        if type(selection)=="table" and type(selection.Name)=="string" and F.Finite(selection.Revision) then self:Equip(player,index,selection.Name,selection.Revision) end
    end
    handlers.DiscardWand=function(player,index,selection)
        if type(selection)=="table" and type(selection.Name)=="string" and F.Finite(selection.Revision) then self:Discard(player,index,selection.Name,selection.Revision) end
    end
    handlers.BuyWand=function(player) self:Buy(player) end
    handlers.CommissionWand=function(player,id) if type(id)=="string" then self:Commission(player,id) end end
end
return W
]]></ProtectedString>
					<string name="ScriptGuid">{29BD8E82-FE1B-4265-99C4-44C1C4D6BDF2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WandService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">59a37b0492e9fce90aef433e00000b4f</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXCB73F24BA62D42BDB33DDD4CA3982BAF">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.Config)
local Spells=require(RS.Shared.SpellData)
local Quests=require(RS.Shared.QuestData)
local Wands=require(RS.Shared.WandData)
local F=require(RS.Shared.Formulas)
-- Testing tools for the admin panel (P). Studio playtests always qualify; on a live server only the
-- experience owner and the user ids listed in ADMINS do. Every command is checked here, never on the client.
local ADMINS={}
local ITEMS={"Health Draught","Frigora Tome","Somnara Tome","Thorn Barb","Spider Silk","Wisp Essence","Moonhowler Fang","Heartwood","Widow's Bite trophy"}
local A={}
function A:Init(services) self.S=services end
function A:IsAdmin(player)
    return RunService:IsStudio() or ADMINS[player.UserId]==true
        or (game.CreatorType==Enum.CreatorType.User and player.UserId==game.CreatorId)
end
-- Learns a spell whatever the player's level, filling an empty slot the way ProgressionService:Learn does.
function A:Teach(d,id)
    local sp=Spells[id]; if not sp or not sp.Implemented or d.Spells[id] then return end
    d.Spells[id]={Mastery=1,Hits=0}
    if id=="Scintara" or id=="Aegara" then return end
    for _,value in pairs(d.Loadout) do if value==id then return end end
    for i=1,4 do local key="Slot"..i; if d.Loadout[key]=="" then d.Loadout[key]=id; return end end
end
-- What Oakhart's first visit grants: the right to hold a wand and the three starter spells.
function A:Starter(d)
    d.HasWand=true
    for _,id in ipairs({"Scintara","Aegara","Glimmora"}) do self:Teach(d,id) end
end
function A:SetLevel(player,d,level)
    if level<d.Level then d.Attributes={Power=0,Focus=0,Vitality=0,Agility=0,Unspent=(level-1)*2}; d.Talents={}
    else d.Attributes.Unspent=d.Attributes.Unspent+(level-d.Level)*2 end
    d.Level=level; d.XP=0
    self.S.CombatService:UpdateStats(player,true)
end
local commands={}
function commands.Level(self,player,d,level)
    if not F.Finite(level) or level%1~=0 then return end
    self:SetLevel(player,d,math.clamp(level,1,Config.LevelCap))
    return "Level "..d.Level.." · attribute and skill points updated"
end
function commands.XP(self,player,d) self.S.ProgressionService:Award(player,1000,0); return "+1,000 XP" end
function commands.Gilders(self,player,d) d.Gilders=d.Gilders+1000; return "+1,000 Gilders" end
function commands.Items(self,player,d)
    for _,item in ipairs(ITEMS) do d.Inventory[item]=(d.Inventory[item] or 0)+5 end
    return "Added 5 of every potion, tome and material to your bag"
end
function commands.Refill(self,player,d)
    self.S.CombatService:UpdateStats(player,true)
    local s=self.S.CombatService.States[player]; if s then s.Cooldowns={}; s.Stamina=100 end
    return "Health, mana and stamina refilled · cooldowns reset"
end
function commands.FreeCast(self,player,d)
    local on=not player:GetAttribute("FreeCast"); player:SetAttribute("FreeCast",on)
    return on and "Free casting ON · no mana cost or cooldowns" or "Free casting OFF"
end
function commands.LearnAll(self,player,d)
    self:Starter(d)
    for id in pairs(Spells) do self:Teach(d,id) end
    return "Every spell is learned. Assign them with K or the slot buttons here."
end
function commands.Mastery(self,player,d)
    for _,s in pairs(d.Spells) do s.Mastery=5; s.Hits=math.max(s.Hits,300) end
    return "All learned spells are at Mastery 5"
end
function commands.Assign(self,player,d,pick)
    if type(pick)~="table" or type(pick.Spell)~="string" or type(pick.Slot)~="string" or not Spells[pick.Spell] then return end
    self:Starter(d); self:Teach(d,pick.Spell)
    self.S.NetworkService.Handlers.Loadout(player,pick.Slot,pick.Spell)
end
function commands.Wand(self,player,d,rarity)
    if type(rarity)~="string" or not Wands.Rarities[rarity] then return end
    self:Starter(d)
    local wand=Wands.Roll(rarity)
    if not self.S.WandService:Grant(player,wand) then return "Your wand case is full. Discard a wand in your bag (B) first." end
    return "Added to your bag: "..Wands.Name(wand)
end
function commands.Named(self,player,d,id)
    if type(id)~="string" or not Wands.Named[id] then return end
    self:Starter(d)
    self.S.WandService:GrantNamed(player,id,"Added to your bag: %s")
end
function commands.House(self,player,d,house)
    if type(house)~="string" or not Config.Houses[house] then return end
    d.House=house; self.S.ProgressionService:Event(player,"Sorted"); self.S.CombatService:UpdateStats(player,true)
    return "You now belong to "..house.." · "..Config.Houses[house].Perk
end
function commands.Waystones(self,player,d)
    for id in pairs(Config.Waystones) do d.Waystones[id]=true end
    return "Every Waystone is attuned"
end
-- Jumps the story to quest `index` (one past the last means finished), completing everything before it.
function commands.Quest(self,player,d,index)
    if not F.Finite(index) or index%1~=0 or index<1 or index>#Quests+1 then return end
    if index>1 then
        self:Starter(d)
        if #d.Wands==0 then self.S.WandService:Grant(player,Wands.Roll("Common")) end
    end
    d.QuestDone={}; d.Quest=index; d.QuestProgress=0
    for i,q in ipairs(Quests) do
        if i<index then
            d.QuestDone[q.Id]=true
            if q.Id=="Seal" then d.SealDefeated=true end
            if q.Id=="Vexweave" then d.BossDefeated=true end
            if q.Wand and not d.WandRewards[q.Wand] then
                d.WandRewards[q.Wand]=true
                self.S.WandService:GrantNamed(player,q.Wand,"Quest reward: %s. Equip it from your bag.")
            end
        end
    end
    local q=Quests[index]
    return q and "Story moved to: "..q.Title or "The alpha story is complete"
end
-- Lands beside a marker (or a Waystone's travel point) on whatever floor is there.
function commands.Teleport(self,player,d,name)
    if type(name)~="string" then return end
    local target
    local point=Config.Waystones[name]
    if point then target=Vector3.new(point[1],point[2],point[3]) else
        local marker=self.S.WorldService:Anchor(name); if not marker then return end
        -- Cast down from head height, not from the sky, so indoor markers land on the floor and not the roof.
        local above=marker.Position+Vector3.new(0,4,7)
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={player.Character,workspace.Markers}
        local hit=workspace:Raycast(above,Vector3.new(0,-20,0),params)
        target=hit and hit.Position+Vector3.new(0,3,0) or marker.Position+Vector3.new(0,3,7)
    end
    self.S.WorldService:Teleport(player,target)
end
function A:Start()
    local function mark(player) if self:IsAdmin(player) then player:SetAttribute("Admin",true) end end
    Players.PlayerAdded:Connect(mark)
    for _,player in ipairs(Players:GetPlayers()) do mark(player) end
    self.S.NetworkService.Handlers.Admin=function(player,command,arg)
        local d=self.S.PlayerDataService:Get(player); local fn=type(command)=="string" and commands[command]
        if not d or not fn or not self:IsAdmin(player) then return end
        local message=fn(self,player,d,arg)
        self.S.ProgressionService:Refresh(player)
        if message then self.S.NetworkService:Notice(player,message) end
    end
end
return A
]]></ProtectedString>
					<string name="ScriptGuid">{F16C07C7-ED98-47F1-A02E-72AFA48190B5}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AdminService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">15a4c60d0ecd54ab0af44f5f00001593</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF490B61921A54A68945F29090B187C3F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Brooms = require(RS.Shared.BroomData)
-- Broom flight. The server decides who may fly and welds their broom (ReplicatedStorage.Brooms) under them; the
-- rider's own client flies the character, which it owns (FlightController). A rider is grounded by a hit, a duel,
-- crowd control, Whisperwood's sky or the ceiling.
local F = {}
function F:Init(services) self.S = services; self.Riders = {}; self.LastToggle = {} end
-- Whether `player` may take off now, and why not.
function F:CanFly(player)
    local d = self.S.PlayerDataService:Get(player); local s = self.S.CombatService.States[player]
    local root = self.S.WorldService:Root(player)
    if not d or not s or not root or s.Humanoid.Health <= 0 then return false end
    if not d.HasWand then return false, "Visit Oakhart in Hollowmere for your wand, and your first broom comes with it." end
    if self.S.DuelService:IsBusy(player) then return false, "Duels are fought on foot." end
    if not self.S.CombatService:CanAct(s) or self.S.CombatService:Has(s, "Rooted") then return false, "You can't take off right now." end
    if os.clock()-s.LastCombat < Brooms.CombatLockout then return false, "Catch your breath: you can fly a few seconds after combat." end
    if not self.S.WorldService:Zone(root.Position).Safe then return false, "Whisperwood's old wards keep brooms out of its sky." end
    return true
end
function F:Mount(player)
    local ok, reason = self:CanFly(player)
    if not ok then if reason then self.S.NetworkService:Notice(player, reason) end; return false end
    local d = self.S.PlayerDataService:Get(player); local s = self.S.CombatService.States[player]
    local folder = RS:FindFirstChild("Brooms"); local template = folder and folder:FindFirstChild(d.Broom)
    if not template or not template.PrimaryPart then
        self.S.NetworkService:Notice(player, "The brooms aren't in this place yet (blender/place_brooms.lua).")
        return false
    end
    local broom = template:Clone(); broom.Name = "RavenmoorBroom"
    local seat = broom.PrimaryPart
    -- The broom pivots on its seat, which sits on the shaft between the rider's legs.
    local weld = Instance.new("Weld"); weld.Name = "Seat"; weld.Part0 = s.Root; weld.Part1 = seat
    weld.C0 = CFrame.new(0, -Brooms.SeatDrop, 0); weld.C1 = seat.PivotOffset; weld.Parent = seat
    broom.Parent = s.Model
    self.Riders[player] = {Broom = d.Broom, Model = broom, Character = s.Model, Since = os.clock()}
    s.FlySpeed = Brooms.Brooms[d.Broom].Speed
    player:SetAttribute("Broom", d.Broom)
    return true
end
function F:Dismount(player, reason)
    local rider = self.Riders[player]; if not rider then return end
    self.Riders[player] = nil; self.LastToggle[player] = os.clock()
    rider.Model:Destroy()
    local s = self.S.CombatService.States[player]; if s then s.FlySpeed = nil end
    -- A rider still carries some speed for a moment after landing.
    local moved = self.S.WorldService.Movement[player]; if moved then moved.Grace = math.max(moved.Grace or 0, os.clock()+1.5) end
    player:SetAttribute("Broom", nil)
    if reason then self.S.NetworkService:Notice(player, reason) end
end
function F:Toggle(player)
    local now = os.clock()
    if now-(self.LastToggle[player] or -100) < Brooms.ToggleCooldown then return end
    self.LastToggle[player] = now
    if self.Riders[player] then self:Dismount(player) else self:Mount(player) end
end
function F:Choose(player, id)
    local d = self.S.PlayerDataService:Get(player); local broom = type(id) == "string" and Brooms.Brooms[id]
    if not d or not broom then return end
    if not Brooms.Unlocked(d, id) then return self.S.NetworkService:Notice(player, broom.Title.." unlocks at level "..broom.Level..".") end
    d.Broom = id; self.S.NetworkService:Sync(player)
    -- Swap brooms in the air.
    if self.Riders[player] and self.Riders[player].Broom ~= id then self:Dismount(player); self:Mount(player) end
end
-- Ground every rider who may no longer fly.
function F:Check()
    local combat = self.S.CombatService
    for player, rider in pairs(self.Riders) do
        local s = combat.States[player]
        if not player.Parent or not s or s.Model ~= rider.Character or not rider.Model.Parent or s.Humanoid.Health <= 0 then
            self:Dismount(player)
        elseif (s.HurtAt or 0) > rider.Since then self:Dismount(player, "The hit knocks you off your broom!")
        elseif self.S.DuelService:IsBusy(player) then self:Dismount(player, "Duels are fought on foot.")
        elseif not combat:CanAct(s) or combat:Has(s, "Rooted") then self:Dismount(player, "You tumble off your broom.")
        elseif not self.S.WorldService:Zone(s.Root.Position).Safe then self:Dismount(player, "Whisperwood's old wards pull you from the sky.")
        elseif s.Root.Position.Y > Brooms.Ceiling+25 then self:Dismount(player, "The air is too thin to fly this high.")
        end
    end
end
function F:Start()
    local net = self.S.NetworkService
    net.Handlers.Fly = function(player) self:Toggle(player) end
    net.Handlers.ChooseBroom = function(player, id) self:Choose(player, id) end
    Players.PlayerRemoving:Connect(function(player) self.Riders[player] = nil; self.LastToggle[player] = nil end)
    task.spawn(function()
        while true do task.wait(0.25); self:Check() end
    end)
end
return F
]]></ProtectedString>
