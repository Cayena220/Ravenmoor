					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WorldPoints</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb639000000760</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX792974913B3C4C32ADBF6280415AC196">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Builds a wand from parts, no assets. The grip sits at `at`; the wand points along at's -Z.
-- anchored=true makes a static preview (bag); otherwise parts are welded to the handle for a hand.
local Wands = require(game:GetService("ReplicatedStorage").Shared.WandData)
local M = {}
local function rgb(c, scale) scale = scale or 1; return Color3.fromRGB(math.min(255, c[1]*scale), math.min(255, c[2]*scale), math.min(255, c[3]*scale)) end
function M.Build(wand, at, anchored)
    local wood, core, rarity = Wands.Woods[wand.Wood], Wands.Cores[wand.Core], Wands.Rarities[wand.Rarity]
    local body = wand.Named and Wands.Named[wand.Named].Body
    local model = Instance.new("Model"); model.Name = "Wand"
    local along = CFrame.Angles(0, math.pi/2, 0) -- Cylinders run along X; turn them to run along Z.
    local function part(name, shape, size, z, color, material)
        local p = Instance.new("Part"); p.Name = name; p.Shape = shape; p.Size = size
        p.Color = color; p.Material = material or Enum.Material.Wood
        p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.Massless = true; p.CastShadow = false
        p.Anchored = anchored == true
        p.CFrame = at * CFrame.new(0, 0, z) * (shape == Enum.PartType.Cylinder and along or CFrame.new())
        p.Parent = model
        return p
    end
    -- A thin cylinder leaving (y, z), tilted `angle` degrees from the tip direction toward +Y.
    local function seg(name, len, girth, y, z, angle, color, material)
        local p = part(name, Enum.PartType.Cylinder, Vector3.new(len, girth, girth), z, color, material)
        p.CFrame = at * CFrame.new(0, y, z) * CFrame.Angles(math.rad(angle), 0, 0) * CFrame.new(0, 0, -len/2) * along
        return p
    end
    -- An ellipsoid (sphere SpecialMesh on a block), long along Z, tilted `angle` degrees toward +Y.
    local function oval(name, size, y, z, angle, color, material)
        local p = part(name, Enum.PartType.Block, size, z, color, material)
        p.CFrame = at * CFrame.new(0, y, z) * CFrame.Angles(math.rad(angle), 0, 0)
        local mesh = Instance.new("SpecialMesh"); mesh.MeshType = Enum.MeshType.Sphere; mesh.Parent = p
        return p
    end
    local function ball(name, size, y, z, color, material)
        local p = part(name, Enum.PartType.Ball, Vector3.one*size, z, color, material)
        p.CFrame = at * CFrame.new(0, y, z)
        return p
    end
    local t, length = wood.Thickness, Wands.Length(wand)
    local metal, glow, neon = rgb(rarity.Metal), rgb(core.Color), Enum.Material.Neon
    local handle = part("Handle", Enum.PartType.Cylinder, Vector3.new(0.8, t*1.6, t*1.6), 0.05, rgb(wood.Color, 0.72))
    model.PrimaryPart = handle
    part("Pommel", Enum.PartType.Ball, Vector3.one*t*2, 0.5, metal, Enum.Material.Metal)
    local shaftEnd = body == "Forked" and 1.8 or length
    part("Shaft", Enum.PartType.Cylinder, Vector3.new(shaftEnd-0.35, t, t), -0.35-(shaftEnd-0.35)/2, rgb(wood.Color))
    local tip
    if body == "Forked" then
        -- Stormfork: the shaft splits at a brass collar into two prongs; the spark between them is the tip.
        ball("Collar", t*1.3, 0, -shaftEnd, metal, Enum.Material.Metal)
        for _, side in ipairs({1, -1}) do
            local a = math.rad(24)
            seg("Prong", 0.34, t*0.55, 0, 0.02-shaftEnd, 24*side, rgb(wood.Color, 0.9))
            ball("Cap", t*0.65, side*0.34*math.sin(a), 0.02-shaftEnd-0.34*math.cos(a), glow, neon)
        end
        for i = 0, 3 do part("Coil", Enum.PartType.Cylinder, Vector3.new(0.05, t*1.35, t*1.35), -0.75-i*0.12, metal, Enum.Material.Metal) end
        tip = part("Tip", Enum.PartType.Ball, Vector3.one*t*0.8, -2.07, glow, neon); tip.Transparency = 0.2
    elseif body == "Fang" then
        -- Widow's Bite: a stretched fang between two mandibles, eight legs and a silk-wrapped grip.
        for side = 1, -1, -2 do oval("Mandible", Vector3.new(t*0.42, t*0.42, t*1.01), side*t*0.6, -length, -14*side, metal, Enum.Material.Metal) end
        tip = oval("Tip", Vector3.new(t, t, t*2.6), 0, -length-0.07, 0, glow, neon); tip.Transparency = 0.15
        for i = 0, 3 do
            local z = -0.72-i*0.26
            for _, angle in ipairs({128, -128}) do
                seg("Leg", 0.22, t*0.3, 0, z, angle, rgb(wood.Color))
                ball("Claw", t*0.36, 0.22*math.sin(math.rad(angle)), z-0.22*math.cos(math.rad(angle)), rgb(wood.Color))
            end
        end
        for _, z in ipairs({0.3, 0.2, 0.1}) do part("Silk", Enum.PartType.Cylinder, Vector3.new(0.07, t*1.68, t*1.68), z, rgb(Wands.Trims.Silk), Enum.Material.Fabric) end
    else
        tip = part("Tip", Enum.PartType.Ball, Vector3.one*t*1.1, -length, glow, neon); tip.Transparency = 0.15
    end
    local attachment = Instance.new("Attachment"); attachment.Name = "Tip"; attachment.Parent = tip
    local rank = ({Common = 0, Uncommon = 1, Rare = 2, Epic = 3})[wand.Rarity]
    if rank >= 1 then part("Band", Enum.PartType.Cylinder, Vector3.new(0.08, t*1.9, t*1.9), -0.38, metal, Enum.Material.Metal) end
    if rank >= 2 then
        part("Band", Enum.PartType.Cylinder, Vector3.new(0.08, t*1.9, t*1.9), 0.4, metal, Enum.Material.Metal)
        part("Core", Enum.PartType.Cylinder, Vector3.new(0.18, t*1.7, t*1.7), -0.12, glow, neon)
    end
    if rank >= 3 then part("Collar", Enum.PartType.Cylinder, Vector3.new(0.06, t*1.5, t*1.5), 0.1-length, metal, Enum.Material.Metal) end
    for i = 1, body ~= "Fang" and (wood.Thorns or wood.Knots) and 3 or 0 do
        local z = -0.55-(length-0.8)*i/4
        local bump = part(wood.Thorns and "Thorn" or "Knot", Enum.PartType.Ball, Vector3.one*t*(wood.Thorns and 0.7 or 1.25), z, rgb(wood.Color, 0.8))
        if wood.Thorns then bump.CFrame = bump.CFrame * CFrame.new((i % 2 == 0 and 1 or -1)*t*0.45, t*0.3, 0) end
    end
    if body == "Sprout" then
        -- Hearthroot: two roots behind the pommel, a bud under the middle knot and a leaf near the tip.
        local leaf = rgb(Wands.Trims.Leaf)
        for _, angle in ipairs({140, 220}) do
            seg("Root", 0.36, t*0.45, 0, 0.44, angle, rgb(wood.Color, 0.6))
            ball("Root", t*0.5, 0.36*math.sin(math.rad(angle)), 0.44-0.36*math.cos(math.rad(angle)), rgb(wood.Color, 0.6))
        end
        ball("Bud", t*0.5, -t*0.72, -0.55-(length-0.8)/2, leaf, Enum.Material.LeafyGrass)
        local y, z = t*0.4, 0.5-length
        seg("Stem", 0.13, t*0.22, y, z, 50, rgb(Wands.Trims.Leaf, 0.8), Enum.Material.LeafyGrass)
        y, z = y+0.13*math.sin(math.rad(50))+0.1, z-0.13*math.cos(math.rad(50))-0.173
        oval("Leaf", Vector3.new(t*0.25, t*0.85, t*2.3), y, z, 30, leaf, Enum.Material.LeafyGrass)
    end
    model.WorldPivot = at
    if not anchored then
        for _, p in ipairs(model:GetChildren()) do
            if p ~= handle and p:IsA("BasePart") then local weld = Instance.new("WeldConstraint"); weld.Part0 = handle; weld.Part1 = p; weld.Parent = p end
        end
    end
    return model
end
return M
]]></ProtectedString>
					<string name="ScriptGuid">{8B40CFE7-58BE-48DE-A7B2-9946C1382A6A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WandModel</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">59a37b0492e9fce90aef433e00000b4b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6A6F5062057E46A18560EA36A08ABE2D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Wand catalogue. A wand is {Wood, Core, Rarity}; wood and core each grant one small bonus.
-- Effects use the same {Stat, Scope, Amount} shape as skill tree effects (see Formulas.Mods).
-- A named wand also carries Named = <key of W.Named>: fixed parts, a Body (WandModel) and a Signature (combat hooks).
local W = {Capacity = 10, Price = 200}
W.Woods = {
    Ash = {Color = {198, 170, 128}, Length = 2.1, Thickness = 0.15, Effect = {"Damage", "All", 0.03}},
    Willow = {Color = {164, 150, 108}, Length = 2.3, Thickness = 0.13, Effect = {"Heal", "All", 0.06}},
    Rowan = {Color = {140, 84, 62}, Length = 2.0, Thickness = 0.15, Effect = {"Cooldown", "All", 0.03}},
    Blackthorn = {Color = {52, 44, 42}, Length = 2.0, Thickness = 0.15, Thorns = true, Effect = {"Crit", "All", 0.02}},
    Silverbirch = {Color = {222, 220, 208}, Length = 2.2, Thickness = 0.14, Knots = true, Effect = {"ManaCost", "All", 0.04}},
    Ironoak = {Color = {92, 78, 64}, Length = 1.9, Thickness = 0.19, Effect = {"Shield", "All", 0.06}},
    Heartwood = {Color = {184, 112, 58}, Length = 1.9, Thickness = 0.18, Knots = true, Effect = {"Regen", "All", 0.05}},
}
W.Cores = {
    Emberplume = {Color = {255, 140, 64}, Effect = {"Damage", "Fire", 0.05}},
    Frostfang = {Color = {140, 220, 255}, Effect = {"Damage", "Frost", 0.05}},
    Stormglass = {Color = {255, 232, 120}, Effect = {"Damage", "Lightning", 0.05}},
    Wyrmscale = {Color = {200, 90, 255}, Effect = {"Damage", "Arcane", 0.04}},
    Moonmane = {Color = {200, 210, 255}, Effect = {"Duration", "All", 0.06}},
    Vexfang = {Color = {232, 72, 154}, Effect = {"Duration", "Alteration", 0.06}},
}
W.Rarities = {
    Common = {Scale = 1, Weight = 65, Metal = {111, 78, 43}},
    Uncommon = {Scale = 1.5, Weight = 28, Metal = {202, 160, 83}},
    Rare = {Scale = 2, Weight = 7, Metal = {214, 220, 228}},
    Epic = {Scale = 2.5, Weight = 0, Metal = {172, 140, 214}},
}
W.Trims = {Leaf = {110, 158, 74}, Silk = {235, 230, 218}}
-- Heartwood, Vexfang and Epic (weight 0) belong to named wands only, so shop rolls never produce them.
W.Named = {
    Stormfork = {Title = "Stormfork", Wood = "Rowan", Core = "Stormglass", Rarity = "Uncommon", Body = "Forked",
        Signature = "Static", Note = "Static: every 4th Spark Bolt arcs to a second enemy"},
    Hearthroot = {Title = "Hearthroot", Wood = "Heartwood", Core = "Moonmane", Rarity = "Rare", Body = "Sprout",
        Signature = "Sapflow", Note = "Sapflow: each Mend that heals refunds 6 mana",
        Recipe = {Level = 18, Gilders = 600, Items = {Heartwood = 3}}},
    WidowsBite = {Title = "Widow's Bite", Wood = "Blackthorn", Core = "Vexfang", Rarity = "Epic", Body = "Fang", Length = 2.4,
        Signature = "VenomBite", Note = "Venom Bite: ×2 crits on Rooted or Asleep enemies",
        Recipe = {Level = 1, Gilders = 0, Items = {["Widow's Bite trophy"] = 5}}},
}
W.WoodOrder = {"Ash", "Willow", "Rowan", "Blackthorn", "Silverbirch", "Ironoak"}
W.CoreOrder = {"Emberplume", "Wyrmscale", "Moonmane", "Stormglass", "Frostfang"}
W.RarityOrder = {"Common", "Uncommon", "Rare", "Epic"}
W.NamedOrder = {"Stormfork", "Hearthroot", "WidowsBite"}
local labels = {Damage = "damage", Heal = "healing", Cooldown = "cooldowns", Crit = "critical chance",
    ManaCost = "mana costs", Shield = "ward strength", Duration = "effect duration", Regen = "mana regeneration"}

function W.Valid(wand)
    if type(wand) ~= "table" or W.Woods[wand.Wood] == nil or W.Cores[wand.Core] == nil or W.Rarities[wand.Rarity] == nil then return false end
    local named = wand.Named == nil or W.Named[wand.Named]
    return named == true or (named ~= nil and named.Wood == wand.Wood and named.Core == wand.Core and named.Rarity == wand.Rarity)
end
function W.Make(id)
    local n = W.Named[id]
    return {Wood = n.Wood, Core = n.Core, Rarity = n.Rarity, Named = id}
end
function W.Length(wand)
    local n = wand.Named and W.Named[wand.Named]
    return n and n.Length or W.Woods[wand.Wood].Length
end
-- The equipped wand's signature ("Static", "Sapflow" or "VenomBite"), or nil.
function W.Signature(data)
    local wand = data and data.Wands and data.Wands[data.EquippedWand]
    local n = wand and wand.Named and W.Named[wand.Named]
    return n and n.Signature
end
function W.Effects(wand)
    local scale = W.Rarities[wand.Rarity].Scale
    local list = {}
    for _, e in ipairs({W.Woods[wand.Wood].Effect, W.Cores[wand.Core].Effect}) do list[#list+1] = {e[1], e[2], e[3]*scale} end
    return list
end
function W.Name(wand)
    if wand.Named then return W.Named[wand.Named].Title .. " · " .. wand.Rarity .. " " .. wand.Wood .. " wand" end
    return wand.Rarity .. " " .. wand.Wood .. " wand · " .. wand.Core .. " core"
end
function W.Label(wand) return wand.Named and W.Named[wand.Named].Title or wand.Wood .. " / " .. wand.Core end
function W.Describe(wand)
    local parts = {}
    for _, e in ipairs(W.Effects(wand)) do
        local reduce = e[1] == "Cooldown" or e[1] == "ManaCost"
        local scope = e[2] ~= "All" and e[2] .. " " or ""
        parts[#parts+1] = string.format("%s%g%% %s%s", reduce and "-" or "+", math.floor(e[3]*1000+0.5)/10, scope, labels[e[1]])
    end
    local text = table.concat(parts, "  ·  ")
    return wand.Named and text .. "\n" .. W.Named[wand.Named].Note or text
end
function W.RollRarity()
    local total = 0; for _, id in ipairs(W.RarityOrder) do total = total + W.Rarities[id].Weight end
    local roll = math.random()*total
    for _, id in ipairs(W.RarityOrder) do roll = roll - W.Rarities[id].Weight; if roll < 0 then return id end end
    return "Common"
end
function W.Roll(rarity)
    return {Wood = W.WoodOrder[math.random(#W.WoodOrder)], Core = W.CoreOrder[math.random(#W.CoreOrder)], Rarity = rarity or W.RollRarity()}
end
-- Saved data repair: drops unknown wands, converts the old "Wood / Core" text wand, clamps the equipped index.
function W.Sanitize(data)
    for i = #data.Wands, 1, -1 do if not W.Valid(data.Wands[i]) then table.remove(data.Wands, i) end end
    while #data.Wands > W.Capacity do table.remove(data.Wands) end
    if data.WandsHeld then for i = #data.WandsHeld, 1, -1 do if not W.Named[data.WandsHeld[i]] then table.remove(data.WandsHeld, i) end end end
    if data.HasWand and #data.Wands == 0 then
        local wood, core = data.Wand:match("^(%a+) / (%a+)$")
        data.Wands[1] = W.Woods[wood] and W.Cores[core] and {Wood = wood, Core = core, Rarity = "Common"} or W.Roll("Common")
    end
    if data.EquippedWand % 1 ~= 0 or data.EquippedWand < 1 or data.EquippedWand > #data.Wands then data.EquippedWand = #data.Wands > 0 and 1 or 0 end
    data.Wand = data.Wands[data.EquippedWand] and W.Label(data.Wands[data.EquippedWand]) or ""
end
return W
]]></ProtectedString>
					<string name="ScriptGuid">{A8264348-2725-4F20-AB38-B058026DECC3}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WandData</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">59a37b0492e9fce90aef433e00000b4c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE2A83833558445D38166D7A1355CEF74">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Skill tree: one point per level after level 1. Deeper tiers need points already spent in that school.
-- Effects are {Stat, Scope, Amount per rank}; Formulas.Mods sums them with the equipped wand's effects.
local S = {Schools = {"Hex", "Ward", "Charm", "Restoration", "Alteration"}, Talents = {}, Order = {}, Requires = {0, 3, 6}}
local function add(id, school, name, tier, maxRank, text, effects)
    S.Talents[id] = {Id = id, School = school, Name = name, Tier = tier, MaxRank = maxRank, Text = text, Effects = effects, Requires = S.Requires[tier]}
    S.Order[school] = S.Order[school] or {}
    table.insert(S.Order[school], id)
end
add("SearingFocus", "Hex", "Searing Focus", 1, 3, "+3% Hex damage per rank.", {{"Damage", "Hex", 0.03}})
add("ElementalAttunement", "Hex", "Elemental Attunement", 1, 3, "+3% Fire, Frost and Lightning damage per rank.", {{"Damage", "Fire", 0.03}, {"Damage", "Frost", 0.03}, {"Damage", "Lightning", 0.03}})
add("QuickenedHexes", "Hex", "Quickened Hexes", 2, 2, "-5% Hex cooldowns per rank.", {{"Cooldown", "Hex", 0.05}})
add("Overload", "Hex", "Overload", 3, 1, "+5% critical chance.", {{"Crit", "All", 0.05}})
add("ThickWards", "Ward", "Thick Wards", 1, 3, "+8% ward shield strength per rank.", {{"Shield", "All", 0.08}})
add("SteadyStance", "Ward", "Steady Stance", 1, 3, "-2% damage taken per rank.", {{"Guard", "All", 0.02}})
add("WardensRhythm", "Ward", "Warden's Rhythm", 2, 2, "-6% Ward cooldowns per rank.", {{"Cooldown", "Ward", 0.06}})
add("Bulwark", "Ward", "Bulwark", 3, 1, "+8% maximum health.", {{"Health", "All", 0.08}})
add("NimbleCharms", "Charm", "Nimble Charms", 1, 3, "-4% Charm cooldowns per rank.", {{"Cooldown", "Charm", 0.04}})
add("EfficientCasting", "Charm", "Efficient Casting", 1, 3, "-3% mana cost of all spells per rank.", {{"ManaCost", "All", 0.03}})
add("LingeringCharms", "Charm", "Lingering Charms", 2, 2, "+10% Charm effect duration per rank.", {{"Duration", "Charm", 0.10}})
add("DeepReserves", "Charm", "Deep Reserves", 3, 1, "+10% maximum mana and mana regeneration.", {{"Mana", "All", 0.10}, {"Regen", "All", 0.10}})
add("GentleHands", "Restoration", "Gentle Hands", 1, 3, "+8% healing per rank.", {{"Heal", "All", 0.08}})
add("VitalFlow", "Restoration", "Vital Flow", 1, 3, "+5% mana regeneration per rank.", {{"Regen", "All", 0.05}})
add("RenewingSpirit", "Restoration", "Renewing Spirit", 2, 2, "+3% maximum health per rank.", {{"Health", "All", 0.03}})
add("Lifebloom", "Restoration", "Lifebloom", 3, 1, "+15% healing and -10% Restoration cooldowns.", {{"Heal", "All", 0.15}, {"Cooldown", "Restoration", 0.10}})
add("BindingMastery", "Alteration", "Binding Mastery", 1, 3, "+6% Alteration effect duration per rank.", {{"Duration", "Alteration", 0.06}})
add("Stonecaller", "Alteration", "Stonecaller", 1, 3, "-6% Alteration mana cost per rank.", {{"ManaCost", "Alteration", 0.06}})
add("PatientWeaving", "Alteration", "Patient Weaving", 2, 2, "-6% Alteration cooldowns per rank.", {{"Cooldown", "Alteration", 0.06}})
add("Dreamweaver", "Alteration", "Dreamweaver", 3, 1, "+8% duration for every effect you apply.", {{"Duration", "All", 0.08}})

function S.Points(level) return math.max(0, level-1) end
function S.Spent(talents, school)
    local total = 0
    for id, rank in pairs(talents) do local t = S.Talents[id]; if t and (not school or t.School == school) then total = total+rank end end
    return total
end
function S.CanLearn(data, id)
    local t = S.Talents[id]; if not t then return false, "Unknown skill." end
    local rank = data.Talents[id] or 0
    if rank >= t.MaxRank then return false, t.Name .. " is already mastered." end
    if S.Spent(data.Talents) >= S.Points(data.Level) then return false, "No skill points left. You earn one each level." end
    if S.Spent(data.Talents, t.School) < t.Requires then return false, "Spend " .. t.Requires .. " points in " .. t.School .. " first." end
    return true
end
-- Saved data repair: unknown skills are dropped and ranks clamped; an overspent tree is refunded.
function S.Sanitize(data)
    for id, rank in pairs(data.Talents) do
        local t = S.Talents[id]
        if not t or type(rank) ~= "number" or rank ~= rank or rank < 1 then data.Talents[id] = nil else data.Talents[id] = math.min(t.MaxRank, math.floor(rank)) end
    end
    if S.Spent(data.Talents) > S.Points(data.Level) then data.Talents = {} end
end
return S
]]></ProtectedString>
