			<Item class="ModuleScript" referent="RBX00000387">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- All tuning lives here or in the data modules. No asset downloads are required.
return {
    Version = "0.1.0", LevelCap = 20, WalkSpeed = 16, RespawnTime = 5,
    StudioSaves = false, DataStoreName = "Wandbound_Alpha_v1",
    SaveInterval = 60, LockLifetime = 180, MaxMonsters = 25,
    ClassInterval = 300, LessonRewardCooldown = 120, DayLength = 1200,
    Houses = {
        Emberclaw = {Trait = "Courage", Color = {187, 71, 63}, Perk = "+5% attack power"},
        Stoneroot = {Trait = "Loyalty", Color = {204, 156, 64}, Perk = "+5% health and shields"},
        Skyquill = {Trait = "Wisdom", Color = {83, 145, 207}, Perk = "5% shorter cooldowns"},
        Nightfang = {Trait = "Ambition", Color = {75, 163, 123}, Perk = "+5% duel XP and Gilders"},
    },
    HouseOrder = {"Emberclaw", "Stoneroot", "Skyquill", "Nightfang"},
    SortingQuestions = {
        {Q = "A sealed door blocks your path. What do you do?", A = {"Break the seal", "Wait for your friends", "Study the inscription", "Find another entrance"}},
        {Q = "A classmate drops their wand during a duel.", A = {"Stand between them", "Help them recover", "Distract their opponent", "Use the opening wisely"}},
        {Q = "Which discovery matters most?", A = {"A dangerous new spell", "A cure for a friend", "An ancient library", "A secret passage"}},
        {Q = "Your group is lost in Whisperwood.", A = {"Lead the way", "Keep everyone together", "Read the stars", "Follow a hidden trail"}},
        {Q = "What will Ravenmoor remember you for?", A = {"My courage", "My loyalty", "My wisdom", "My ambition"}},
    },
    -- A zone can span several rectangles; the first match wins. The academy is its terraces, then its
    -- house quarters and gardens to the north.
    Zones = {
        {Id = "Castle", Name = "Ravenmoor Academy", Center = {90, -196.5}, Size = {220, 297}, Safe = true},
        {Id = "Castle", Name = "Ravenmoor Academy", Center = {0, -497.5}, Size = {660, 305}, Safe = true},
        {Id = "Whisperwood", Name = "Whisperwood", Center = {-155, -35}, Size = {270, 400}, Safe = false},
        {Id = "Hollowmere", Name = "Hollowmere Village", Center = {90, 140}, Size = {260, 155}, Safe = true},
        {Id = "Grounds", Name = "Castle Grounds", Center = {100, 0}, Size = {270, 130}, Safe = true},
    },
    Waystones = {Hollowmere = {90, 5, 164}, Castle = {85, 5, -58}, Whisperwood = {-36, 5, 20}},
    -- Players outside these limits are returned to their last position.
    WorldBounds = {MinX = -340, MaxX = 340, MinZ = -655, MaxZ = 290},
    Teachers = {
        Hex = {Name = "Professor Rook", Title = "Hexcraft", Anchor = "Teacher_Hex"},
        Ward = {Name = "Professor Holloway", Title = "Warding", Anchor = "Teacher_Ward"},
        Charm = {Name = "Professor Quill", Title = "Charms", Anchor = "Teacher_Charm"},
        Restoration = {Name = "Healer Fenn", Title = "Restoration", Anchor = "Teacher_Restoration"},
        Alteration = {Name = "Professor Ashgrove", Title = "Alteration", Anchor = "Teacher_Alteration"},
    },
    Subjects = {"Charm", "Hex", "Ward", "Restoration", "Alteration"},
}
]]></ProtectedString>
					<string name="ScriptGuid">{41E44F61-8187-4BA4-9F63-D749FE8E6B2F}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000075a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000388">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage").Shared
local Wands = require(Shared.WandData)
local Skills = require(Shared.SkillData)
local F = {}
function F.XP(level) return math.floor(100 * level ^ 1.5) end
-- Sums the equipped wand and learned skills into mods[Stat][Scope]; F.Mod reads them back.
function F.Mods(data)
    local mods = {}
    local function add(stat, scope, amount) local m = mods[stat] or {}; mods[stat] = m; m[scope] = (m[scope] or 0) + amount end
    local wand = data.Wands and data.Wands[data.EquippedWand]
    if wand and Wands.Valid(wand) then for _, e in ipairs(Wands.Effects(wand)) do add(e[1], e[2], e[3]) end end
    for id, rank in pairs(data.Talents or {}) do
        local t = Skills.Talents[id]; if t then for _, e in ipairs(t.Effects) do add(e[1], e[2], e[3]*rank) end end
    end
    return mods
end
function F.Mod(mods, stat, ...)
    local m = mods[stat]; if not m then return 0 end
    local total = m.All or 0
    for _, scope in ipairs({...}) do total = total + (m[scope] or 0) end
    return total
end
function F.Stats(data)
    local a = data.Attributes; local mods = F.Mods(data)
    local hp = 100 + 10 * data.Level + 10 * a.Vitality
    if data.House == "Stoneroot" then hp = hp * 1.05 end
    return {HP = math.floor(hp * (1 + F.Mod(mods, "Health"))), Mana = (100 + 2 * data.Level + 5 * a.Focus) * (1 + F.Mod(mods, "Mana")),
        ManaRegen = (4 + 0.2 * a.Focus) * (1 + F.Mod(mods, "Regen")), Speed = 16 * (1 + math.min(0.15, 0.0025 * a.Agility)),
        Crit = math.min(0.4, math.min(0.25, 0.05 + 0.002 * a.Agility) + F.Mod(mods, "Crit")),
        Guard = math.min(0.15, F.Mod(mods, "Guard"))}
end
function F.Mastery(hits)
    if hits >= 300 then return 5 elseif hits >= 150 then return 4 elseif hits >= 75 then return 3 elseif hits >= 25 then return 2 end
    return 1
end
function F.Power(base, data, spell, spoken)
    local mastery = data.Spells[spell.Id] and data.Spells[spell.Id].Mastery or 1
    local mods = F.Mods(data)
    local bonus = 0
    if spell.Damage > 0 then
        bonus = bonus + F.Mod(mods, "Damage", spell.School, spell.Element)
        if data.House == "Emberclaw" then bonus = bonus + 0.05 end
    end
    if spell.Shield then
        bonus = bonus + F.Mod(mods, "Shield")
        if data.House == "Stoneroot" then bonus = bonus + 0.05 end
    end
    if spell.Heal then bonus = bonus + F.Mod(mods, "Heal") end
    return base * (1 + 0.08 * (data.Level - 1)) * (1 + 0.02 * data.Attributes.Power)
        * (1 + 0.05 * (mastery - 1)) * (1 + bonus) * (spoken and 1.1 or 1)
end
function F.Cooldown(spell, data)
    return spell.Cooldown * (data.House == "Skyquill" and 0.95 or 1) * (1 - math.min(0.4, F.Mod(F.Mods(data), "Cooldown", spell.School)))
end
function F.ManaCost(spell, data) return spell.ManaCost * (1 - math.min(0.4, F.Mod(F.Mods(data), "ManaCost", spell.School))) end
function F.Duration(spell, data) return (spell.Duration or 0) * (1 + F.Mod(F.Mods(data), "Duration", spell.School)) end
function F.Monster(level, rank)
    local hp = rank == "Boss" and 15 or (rank == "Elite" and 3 or 1)
    local damage = rank == "Boss" and 2.5 or (rank == "Elite" and 1.5 or 1)
    local xp = rank == "Boss" and 25 or (rank == "Elite" and 4 or 1)
    local gold = rank == "Boss" and 50 or (rank == "Elite" and 5 or 1)
    return {HP = (50 + 25 * level) * hp, Damage = (5 + 2 * level) * damage,
        XP = (10 + 5 * level) * xp, Gilders = 2 + level * gold}
end
function F.Elo(rating, opponent, games, result)
    return math.floor(rating + (games < 10 and 48 or 32) * (result - 1 / (1 + 10 ^ ((opponent - rating) / 400))) + 0.5)
end
function F.CCMult(count) return ({1, 0.5, 0.25})[count] or 0 end
function F.Finite(n) return type(n) == "number" and n == n and math.abs(n) < 10000000 end
return F
]]></ProtectedString>
					<string name="ScriptGuid">{B185A7EB-49C1-4648-9665-54E09FBCD955}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Formulas</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">03d2e6901b9fab800aeb63900000075b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000389">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Ordered arc-length resampling prevents a stationary point or shuffled rune from passing.
local G = {}
function G.Path(index)
    if index % 3 == 0 then return {{0.15,0.75},{0.35,0.2},{0.55,0.75},{0.8,0.2}} end
    if index % 3 == 1 then return {{0.18,0.25},{0.8,0.25},{0.2,0.75},{0.82,0.75}} end
    local p = {}
    for i = 0, 20 do
        local t = i / 20 * math.pi * 1.8
        p[#p+1] = {0.5 + math.cos(t) * 0.32, 0.5 + math.sin(t) * 0.32}
    end
    return p
end
local function dist(a,b) return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2) end
function G.Resample(points, count)
    local lens, total = {0}, 0
    for i = 2, #points do total = total + dist(points[i], points[i-1]); lens[i] = total end
    if total < 0.1 then return nil end
    local result, j = {}, 2
    for i = 0, count-1 do
        local d = total * i / (count-1)
        while j < #points and lens[j] < d do j = j+1 end
        local t = (d-lens[j-1]) / math.max(0.00001, lens[j]-lens[j-1])
        result[#result+1] = {points[j-1][1]+(points[j][1]-points[j-1][1])*t, points[j-1][2]+(points[j][2]-points[j-1][2])*t}
    end
    return result
end
function G.Score(points, path)
    if type(points) ~= "table" or #points < 8 or #points > 160 then return 0 end
    for _, p in ipairs(points) do
        if type(p) ~= "table" or type(p[1]) ~= "number" or type(p[2]) ~= "number"
            or p[1] ~= p[1] or p[2] ~= p[2] or p[1] < 0 or p[1] > 1 or p[2] < 0 or p[2] > 1 then return 0 end
    end
    local a, b = G.Resample(points, 32), G.Resample(path, 32)
    if not a or not b then return 0 end
    local error = 0
    for i = 1, 32 do error = error + dist(a[i], b[i]) end
    return math.max(0, math.floor(100 * (1 - error / 32 / 0.28)))
end
return G
]]></ProtectedString>
